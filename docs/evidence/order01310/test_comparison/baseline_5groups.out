    def test_full_chain_job_lifecycle_to_verified(harness_env):
        """\u0627\u0644\u0633\u0644\u0633\u0644\u0629 \u0643\u0627\u0645\u0644\u0629: \u062e\u0637\u0629 \u2190 \u0627\u0639\u062a\u0645\u0627\u062f \u2190 \u0641\u062d\u0635 \u2190 \u0648\u0638\u064a\u0641\u0629 \u2190 \u0623\u062f\u0644\u0629 \u2190 \u062a\u062f\u0642\u064a\u0642 \u2190
        checkpoint \u2190 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u062a\u062d\u0642\u0642 \u2190 VERIFIED \u2190 \u0627\u0644\u0648\u0638\u064a\u0641\u0629 COMPLETED."""
        env = harness_env
        sessions = env["sessions"]
        engine = env["build_engine"]()
