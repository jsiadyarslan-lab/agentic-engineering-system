    def _execute_step(self, project: dict, plan: dict, phase: dict,
                      step: dict) -> dict:
        from core.stop_controller import StopController
        from tasks import run_task
    
        project_id = project["id"]
    
        # 1) \u062c\u0627\u0647\u0632\u064a\u0629 \u0627\u0644\u0645\u0632\u0648\u062f\u064a\u0646 (007.1 \xa717): \u062d\u0644 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u2190 \u0627\u0644\u0645\u0632\u0648\u062f \u2190 \u0627\u0644\u062a\u0643\u0648\u064a\u0646
        #    \u2190 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u2190 \u0641\u062d\u0635 \u0642\u0628\u0644 \u0623\u064a \u062a\u0646\u0641\u064a\u0630. \u0644\u0627 \u0646\u0645\u0648\u0630\u062c = EXECUTION_BLOCKED.
        role_selections = self._role_selections()
        router = self._router_factory()
        unready = self._unready_roles(role_selections, router)
        if unready:
            return self._block_on_providers(project, plan, phase, step,
                                            unready)
    
        # 2) \u0633\u062c\u0644 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u062f\u0627\u0626\u0645 (\xa77) \u2014 \u0643\u0644 \u0645\u062d\u0627\u0648\u0644\u0629 \u0633\u062c\u0644 \u0645\u0633\u062a\u0642\u0644
        attempt = step["attempts"] + 1
        workspace = PROJECTS_DIR / str(project_id) / "steps" / str(step["id"])
        workspace.mkdir(parents=True, exist_ok=True)
        # (013.7 \xa7P14) \u0623\u0645\u0631 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0648\u0645\u0633\u0627\u0631 \u0627\u0644\u0639\u0645\u0644
        command_text = step["objective"]
        if step.get("input"):
            command_text += f"\\n\\n\u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a: {step['input']}"
        if step.get("expected_output"):
            command_text += f"\\n\u0627\u0644\u0645\u062e\u0631\u062c \u0627\u0644\u0645\u062a\u0648\u0642\u0639: {step['expected_output']}"
        if step.get("acceptance_criteria"):
            command_text += "\\n\u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0642\u0628\u0648\u0644 (\u062a\u062d\u0642\u0642 \u062d\u0631\u0641\u064a\u064b\u0627):\\n- " + \\
                "\n- ".join(step["acceptance_criteria"])
        # \u0623\u0645\u0627\u0646\u0629 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0627\u0646\u0647\u064a\u0627\u0631: \u062a\u0646\u0641\u064a\u0630 RUNNING \u0628\u0644\u0627 \u062e\u064a\u0637 \u062d\u064a (restart)
        # \u064a\u064f\u0648\u0633\u0645 \u0641\u0634\u0644\u064b\u0627 \u0628\u0633\u0628\u0628 \u0635\u0631\u064a\u062d \u2014 \u0644\u0627 \u064a\u0628\u0642\u0649 \u0645\u0639\u0644\u0642\u064b\u0627 \u0643\u0623\u0646\u0647 \u062d\u064a (\xa79)
