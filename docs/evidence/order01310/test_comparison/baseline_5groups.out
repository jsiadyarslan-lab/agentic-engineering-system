        \u064a\u0648\u0633\u0645 INTERRUPTED \u0648\u064a\u0639\u0644\u0646 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u2014 \u062b\u0645 \u0627\u0644\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u064a\u0643\u0645\u0644."""
