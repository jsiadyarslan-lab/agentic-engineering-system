    def test_search_blocked_goal_blocks_but_fetch_only_goal_proceeds(sessions):
        """\xa739.8 \u0627\u0644\u062c\u0648\u0647\u0631: \u0627\u0644\u0628\u062d\u062b \u0645\u0639\u0637\u0644 \u2260 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0645\u0642\u0637\u0648\u0639 \u2014 \u0645\u0647\u0645\u0629 \u0627\u0644\u062c\u0644\u0628 \u062a\u0633\u062a\u0645\u0631."""
        # \u0634\u0628\u0643\u0629 \u0648\u062c\u0644\u0628 \u0648\u0645\u0644\u0641\u0627\u062a \u062c\u0627\u0647\u0632\u0629\u061b \u0627\u0644\u0628\u062d\u062b \u0645\u0639\u0637\u0644 (\u0627\u0644\u0645\u0632\u0648\u062f \u0641\u064a \u0645\u0635\u062f\u0631\u0647 \u2014 011 \xa712)
        _env_ready(sessions)
        for cap in ("filesystem", "network_dns", "network_https",
