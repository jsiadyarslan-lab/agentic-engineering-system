    def _run_task_to_completion(client, goal="\u062f\u0648\u0631\u0629 \u0643\u0627\u0645\u0644\u0629 \u0644\u0639\u0642\u062f \u0627\u0644\u0625\u064a\u0642\u0627\u0641"):
