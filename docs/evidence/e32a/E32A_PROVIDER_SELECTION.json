{
  "phase": "E32A_PROVIDER_SELECTION_DETERMINISM",
  "description": "Verification that provider/model configuration can be deterministically resolved",
  "selection_sources": {
    "role_based_mapping": {
      "source": "providers_registry.role_provider_mappings table",
      "resolution": "role -> provider -> configuration -> model",
      "deterministic": true,
      "example": "role=reviewer -> provider=nvidia -> config=default -> model=nvidia/nemotron-3-ultra-550b-a55b",
      "all_roles": {
        "thinker": "openai_compatible -> anthropic/claude-haiku-3.5",
        "reviewer": "nvidia -> nvidia/nemotron-3-ultra-550b-a55b",
        "implementer": "nvidia -> nvidia/nemotron-3-ultra-550b-a55b",
        "verifier": "nvidia -> nvidia/nemotron-3-ultra-550b-a55b",
        "arbiter": "nvidia -> nvidia/nemotron-3-ultra-550b-a55b",
        "chat": "nvidia -> nvidia/nemotron-3-ultra-550b-a55b"
      }
    },
    "environment_auto_detect": {
      "source": "src/llm/providers.py create_provider_from_env()",
      "priority_order": [
        "NVIDIA_API_KEY -> NVIDIA provider",
        "OPENAI_API_KEY -> OPENAI provider", 
        "ANTHROPIC_API_KEY -> ANTHROPIC provider",
        "GOOGLE_API_KEY -> GOOGLE provider",
        "Ollama local probe -> OLLAMA provider"
      ],
      "deterministic": true,
      "current_result": "No environment variables set -> ValueError raised"
    },
    "gateway_explicit_config": {
      "source": "GatewayConfig with explicit provider_type, model, api_key",
      "deterministic": true,
      "current_result": "All None -> auto-detect path"
    },
    "secrets_store_resolution": {
      "source": "secrets_store.get_key(provider_name) at runtime",
      "deterministic": true,
      "providers_resolvable": {
        "nvidia": true,
        "openai_compatible": true,
        "zai_internal": false,
        "note": "zai_internal uses config_file auth_type, not bearer token"
      }
    }
  },
  "reconstructible_configuration": {
    "for_each_role": {
      "thinker": {
        "provider": "openai_compatible",
        "model": "anthropic/claude-haiku-3.5",
        "credential_source": "secrets_store (key: openai_compatible)",
        "credential_value": "REDACTED",
        "config_source": "provider_registry database"
      },
      "reviewer": {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "credential_source": "secrets_store (key: nvidia)",
        "credential_value": "REDACTED",
        "config_source": "provider_registry database"
      },
      "implementer": {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "credential_source": "secrets_store (key: nvidia)",
        "credential_value": "REDACTED",
        "config_source": "provider_registry database"
      },
      "verifier": {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "credential_source": "secrets_store (key: nvidia)",
        "credential_value": "REDACTED",
        "config_source": "provider_registry database"
      },
      "arbiter": {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "credential_source": "secrets_store (key: nvidia)",
        "credential_value": "REDACTED",
