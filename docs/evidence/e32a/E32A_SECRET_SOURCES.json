{
  "phase": "E32A_SECRET_SOURCES_AUDIT",
  "description": "Audit of supported secret sources for LLM providers",
  "environment_variables": {
    "NVIDIA_API_KEY": "ABSENT",
    "OPENAI_API_KEY": "ABSENT",
    "ANTHROPIC_API_KEY": "ABSENT",
    "GOOGLE_API_KEY": "ABSENT",
    "OLLAMA_HOST": "ABSENT"
  },
  "secrets_store": {
    "file": "runtime/secrets/secrets.json",
    "encrypted": true,
    "providers_with_keys": [
      "nvidia",
      "openai_compatible",
      "execution::dead-worker-g",
      "execution::wsl2-linux"
    ],
    "key_presence": {
      "nvidia": "PRESENT",
      "openai_compatible": "PRESENT",
      "anthropic": "ABSENT",
      "google": "ABSENT",
      "ollama": "N/A (no auth)"
    }
  },
  "provider_registry_config": {
    "providers_seeded": 3,
    "provider_configurations": 3,
    "role_mappings": 6,
    "providers": [
      {
        "name": "nvidia",
        "type": "nvidia",
        "auth_type": "bearer",
        "has_secret_in_store": true,
        "configurations": 1,
        "default_model": "nvidia/nemotron-3-ultra-550b-a55b"
      },
      {
        "name": "openai_compatible",
        "type": "openai_compatible",
        "auth_type": "bearer",
        "has_secret_in_store": true,
        "configurations": 1,
        "default_model": "anthropic/claude-haiku-3.5"
      },
      {
        "name": "zai_internal",
        "type": "zai_internal",
        "auth_type": "config_file",
        "has_secret_in_store": false,
        "configurations": 1,
        "default_model": "glm-4.6",
        "config_file": "/etc/.z-ai-config"
      }
    ],
    "role_mappings": [
      {"role": "thinker", "provider": "openai_compatible", "model": "anthropic/claude-haiku-3.5"},
      {"role": "reviewer", "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"},
      {"role": "implementer", "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"},
      {"role": "verifier", "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"},
      {"role": "arbiter", "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"},
      {"role": "chat", "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"}
    ]
  },
  "credential_loading_priority": {
    "llm_gateway": "1. Explicit GatewayConfig.api_key, 2. create_client_from_env() auto-detect",
    "providers_py": "1. NVIDIA_API_KEY, 2. OPENAI_API_KEY, 3. ANTHROPIC_API_KEY, 4. GOOGLE_API_KEY, 5. Ollama local probe",
    "providers_registry": "secrets_store.get_key(provider_name) at probe time",
    "factory_orchestrator": "LLMProvider instance passed at construction (api_key injected by caller)"
  },
  "no_secrets_in": [
    "environment variables (all ABSENT)",
    "git repository (verified clean)",
    "database tables (only secret_ref concept, no values)",
    "source code (verified)",
    "test fixtures"
  ]
}