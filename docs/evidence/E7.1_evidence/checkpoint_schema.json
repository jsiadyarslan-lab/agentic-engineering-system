{
  "checkpoint_schema": {
    "class": "Checkpoint",
    "location": "src/unified/domain_model.py",
    "fields": {
      "checkpoint_id": "str (default_factory=new_checkpoint_id)",
      "mission_id": "str",
      "run_id": "str", 
      "step": "int",
      "state": "MissionState",
      "task_states": "Dict[str, TaskState]",
      "artifact_ids": "List[str]",
      "evidence_hashes": "List[str]",
      "created_at": "datetime (default_factory=datetime.utcnow)",
      "hash": "str",
      "task_definitions": "Dict[str, Dict[str, Any]]",
      "task_dependencies": "Dict[str, List[str]]",
      "task_dependents": "Dict[str, List[str]]",
      "attempt_history": "Dict[str, List[Dict[str, Any]]]",
      "agent_assignments": "Dict[str, str]"
    },
    "serialization": "Pydantic JSON (model_dump / model_validate)",
    "file_format": "JSON",
    "version": "1.0"
  }
}