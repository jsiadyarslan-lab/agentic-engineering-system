      {
        "_resourceType": "Script",
        "cache": {},
        "request": {
          "bodySize": 0,
          "cookies": [],
          "headers": [
            {
              "name": "Referer",
              "value": "http://127.0.0.1:18080/"
            }
          ],
          "headersSize": -1,
          "httpVersion": "HTTP/1.1",
          "method": "GET",
          "queryString": [
            {
              "name": "v",
