        "response": {
          "bodySize": 0,
          "content": {
            "mimeType": "text/css",
            "size": 0,
            "text": "/* ==========================================================================\n   Agentic Engineering System — بطاقات المشروع الحية (الأمر 013 §8-§12+§31).\n   منتج محادثة أولًا: الهدف رسالة، والخطة والاعتماد والتنفيذ والأدلة\n   بطاقات أنيقة تتدفق بلا refresh. التصميم على رموز styles.css نفسها\n   (design tokens §32) — لا قيم سحرية هنا، كل شيء من الرموز أو مشتق منها.\n   ========================================================================== */\n\n/* ---------- هيكل العرض ---------- */\n\n.project-view {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-height: 0;\n}\n\n.pl-head-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 18px;\n  border-bottom: 1px solid var(--border-soft);\n  background: var(--bg-sidebar);\n  flex-shrink: 0;\n}\n\n.pl-head-title {\n  font-weight: 600;\n  font-size: 15px;\n  color: var(--text);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 46%;\n}\n\n.pl-head-status {\n  font-size: 12.5px;\n  padding: 2px 10px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  color: var(--text-mid);\n  white-space: nowrap;\n}\n.pl-head-status.live { color: var(--ok); border-color: rgba(127,185,138,.35); }\n.pl-head-status.ok { color: var(--ok); border-color: rgba(127,185,138,.35); }\n.pl-head-status.gold { color: var(--accent); border-color: var(--accent-border); }\n.pl-head-status.warn { color: var(--accent); border-color: rgba(217,178,95,.35); }\n.pl-head-status.danger { color: var(--danger); border-color: var(--danger-border); }\n\n.pl-scroll {\n  flex: 1;\n  overflow-y: auto;\n  min-height: 0;\n  scroll-behavior: smooth;\n}\n\n.pl-scene {\n  max-width: var(--chat-width);\n  margin: 0 auto;\n  padding: 26px 18px 60px;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n}\n\n/* ---------- صفوف المحادثة ---------- */\n\n.pl-row { display: flex; gap: 12px; align-items: flex-start; }\n.pl-avatar {\n  width: 34px; height: 34px;\n  border-radius: var(--radius-s);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 12px; font-weight: 600;\n  flex-shrink: 0;\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  color: var(--text-dim);\n}\n.pl-row.owner .pl-avatar {\n  background: var(--accent-soft);\n  border-color: var(--accent-border);\n  color: var(--accent);\n}\n.pl-flow { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }\n\n.pl-objective-msg {\n  background: var(--bubble-user);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-m);\n  padding: 12px 16px;\n  line-height: 1.85;\n  color: var(--text);\n  white-space: pre-wrap;\n}\n\n/* ---------- البطاقات ---------- */\n\n.pl-card {\n  background: var(--bubble-assistant);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-m);\n  padding: 16px 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  transition: border-color .25s var(--ease), box-shadow .25s var(--ease);\n}\n\n.pl-title { font-weight: 600; font-size: 15px; color: var(--text); }\n.pl-note { color: var(--text-mid); font-size: 13.5px; line-height: 1.8; }\n.pl-meta { display: flex; gap: 10px; flex-wrap: wrap; }\n.pl-meta span {\n  font-size: 12px; color: var(--text-dim);\n  border: 1px solid var(--border-soft);\n  border-radius: 999px; padding: 1px 9px;\n}\n\n.pl-objective {\n  color: var(--text-mid);\n  font-size: 13.5px;\n  border-inline-start: 2px solid var(--border);\n  padding-inline-start: 12px;\n  line-height: 1.8;\n}\n\n/* بطاقة المشروع: الحالة */\n.pl-status {\n  font-size: 12px; padding: 2px 10px; border-radius: 999px;\n  white-space: nowrap;\n}\n.pl-status.ok { color: var(--ok); background: var(--ok-soft); }\n.pl-status.gold { color: var(--accent); background: var(--accent-soft); }\n.pl-status.live { color: var(--ok); background: var(--ok-soft); }\n.pl-status.warn { color: var(--accent); background: rgba(217,178,95,.08); }\n.pl-status.danger { color: var(--danger); background: var(--danger-soft); }\n.pl-status.dim { color: var(--text-dim); background: var(--bg-raised); }\n\n.pl-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\n\n/* ---------- خط الزمن المرحلي (§10+§12) ---------- */\n\n.pl-stages {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 14px;\n  padding-top: 4px;\n}\n.pl-stage {\n  display: flex; align-items: center; gap: 6px;\n  font-size: 12.5px; color: var(--text-faint);\n}\n.pl-stage-icon { font-size: 13px; width: 16px; text-align: center; }\n.pl-stage.done { color: var(--ok); }\n.pl-stage.active { color: var(--accent); }\n.pl-stage.active .pl-stage-icon {\n  display: inline-block;\n  animation: pl-spin 1.6s linear infinite;\n}\n.pl-stage.waiting { color: var(--accent); }\n@keyframes pl-spin { to { transform: rotate(360deg); } }\n\n/* ---------- بطاقة الخطة ----------\n * (013.5 §N) تفاصيل الخطة صارت أقسامًا مسماة قابلة للطي — أنماطها\n * في قسم «013.5 §N» بنهاية الملف، وكل قيمها من رموز styles.css. */\n\n/* ---------- بطاقة الاعتماد (§11) ---------- */\n\n.pl-approval { border-color: var(--accent-border); }\n.pl-approval .pl-title { color: var(--accent); }\n.pl-actions { display: flex; gap: 10px; flex-wrap: wrap; }\n\n/* (007) زر بطاقات المشهد من النظام الموحد — تعريف واحد (كان مكررًا\n   مرتين بقيم متنافرة و primary بنص أبيض فاشل التباين) */\n.pl-btn {\n  border: 1px solid var(--border);\n  background: var(--bg-raised);\n  color: var(--text);\n  border-radius: var(--btn-radius);\n  padding: 8px var(--sp-4);\n  font-size: var(--fs-13);\n  font-weight: 500;\n  font-family: inherit;\n  cursor: pointer;\n  transition: all var(--dur-fast) var(--ease);\n}\n.pl-btn:hover:not(:disabled) { border-color: var(--border-strong); background: var(--bg-hover); }\n.pl-btn:disabled { opacity: .55; cursor: not-allowed; }\n.pl-btn.primary {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: var(--accent-ink);\n  font-weight: 600;\n}\n.pl-btn.primary:hover:not(:disabled) { background: var(--accent-strong); }\n.pl-btn.danger { color: var(--danger); border-color: var(--danger-border); }\n.pl-btn.danger:hover:not(:disabled) { background: var(--danger-soft); }\n\n.pl-feedback {\n  font-size: 13px; line-height: 1.7;\n  padding: 8px 12px;\n  border-radius: var(--radius-s);\n  border: 1px solid var(--border-soft);\n  color: var(--text-mid);\n}\n.pl-feedback.loading { color: var(--accent); border-color: var(--accent-border); }\n.pl-feedback.ok { color: var(--ok); border-color: rgba(127,185,138,.3); }\n.pl-feedback.err { color: var(--danger); border-color: var(--danger-border); }\n.pl-feedback-detail { font-size: 12px; color: var(--text-dim); margin-top: 4px; }\n\n/* ---------- بطاقة الحجب (§27) ---------- */\n\n.pl-blocked { border-color: rgba(217,178,95,.4); }\n.pl-blocked .pl-title { color: var(--accent); }\n.pl-progress {\n  font-size: 13px; color: var(--text-mid);\n  padding: 8px 12px; border-radius: var(--radius-s);\n  background: var(--bg-raised);\n  line-height: 1.7;\n}\n.pl-progress.ok { color: var(--ok); }\n\n/* ---------- النشاط الحي (§22+§28) ---------- */\n\n.pl-activity-list {\n  display: flex; flex-direction: column; gap: 7px;\n  max-height: 320px; overflow-y: auto;\n}\n.pl-act {\n  display: flex; gap: 9px; align-items: baseline;\n  font-size: 13px; color: var(--text-mid);\n  animation: pl-fade-in .3s var(--ease);\n}\n.pl-act-icon { flex-shrink: 0; font-size: 12.5px; }\n.pl-act.role { color: var(--accent); }\n.pl-act.err { color: var(--danger); }\n.pl-act.waiting { color: var(--accent); }\n@keyframes pl-fade-in { from { opacity: 0; transform: translateY(3px); } }\n\n/* ---------- التحقق النهائي (§51) ---------- */\n\n.pl-verify { border-color: var(--accent-border); }\n.pl-verify.done { border-color: rgba(127,185,138,.4); }\n.pl-verify.done .pl-title { color: var(--ok); }\n\n/* ---------- التفاصيل التقنية المطوية (§9+§29) ---------- */\n\n.pl-tech { margin-top: 2px; }\n.pl-tech-toggle {\n  background: none; border: none; cursor: pointer;\n  color: var(--text-faint); font-size: 12px; font-family: inherit;\n  padding: 2px 0;\n}\n.pl-tech-toggle:hover { color: var(--text-mid); }\n.pl-tech-body {\n  margin-top: 6px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-s);\n  padding: 10px 12px;\n  font-size: 11.5px;\n  color: var(--text-dim);\n  max-height: 240px;\n  overflow: auto;\n  font-family: var(--font-mono);\n  text-align: left;\n  white-space: pre-wrap;\n}\n\n.pl-footer { display: flex; flex-direction: column; gap: 6px; }\n.pl-footer-meta { font-size: 11.5px; color: var(--text-faint); text-align: center; }\n\n/* ---------- نافذة الخطة ----------\n * (013.5 §N) كل سطح هنا معلن بلون صريح من رموز الثيم الداكن: لا سطح\n * فاتح موروث ولا نص بلا لون — التباين محفوظ مهما كان ترتيب الأصول. */\n\n.pl-plan-modal {\n  position: fixed; inset: 0;\n  background: rgba(0,0,0,.6);\n  display: flex; align-items: center; justify-content: center;\n  z-index: var(--z-modal);  /* (007 N-2) آخر قيمة حرفية في النظام */\n  padding: 20px;\n  direction: rtl;\n}\n.pl-plan-modal-card {\n  background: var(--bg-elevated);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-l);\n  max-width: 640px; width: 100%;\n  max-height: 82vh;\n  display: flex; flex-direction: column;\n  box-shadow: var(--shadow-modal);\n  overflow: hidden;\n  text-align: start;\n}\n.pl-plan-modal-head {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--border-soft);\n  background: var(--bg-sidebar);\n  color: var(--text);\n  font-weight: 600;\n}\n.pl-plan-modal-body {\n  padding: 12px 18px 20px;\n  overflow-y: auto;\n  display: flex; flex-direction: column; gap: 4px;\n  background: var(--bg-elevated);\n  color: var(--text);\n}\n.pl-plan-modal-body h4 {\n  font-size: 13.5px; color: var(--accent);\n  margin: 12px 0 5px;\n}\n.pl-plan-modal-line {\n  font-size: 13px; color: var(--text-mid);\n  padding: 3px 10px;\n  border-inline-start: 2px solid var(--border-soft);\n  line-height: 1.7;\n  overflow-wrap: anywhere;\n}\n.pl-plan-modal-body pre {\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-s);\n  padding: 10px 12px;\n  color: var(--text-dim);\n  font-size: 11.5px;\n  font-family: var(--font-mono);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n/* ---------- الشريط الجانبي: عناصر المشاريع ---------- */\n\n.pj-item {\n  display: flex; align-items: center; gap: 8px;\n  width: 100%;\n  background: none; border: none; cursor: pointer;\n  color: var(--text-mid);\n  font-family: inherit; font-size: 13px;\n  padding: 6px 10px;\n  border-radius: var(--radius-s);\n  text-align: start;\n  transition: background .15s var(--ease);\n}\n.pj-item:hover { background: var(--bg-raised); color: var(--text); }\n.pj-item.active { background: var(--bg-raised); color: var(--text); }\n.pj-name {\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n}\n.pj-dot {\n  width: 8px; height: 8px; border-radius: 50%;\n  background: var(--text-faint); flex-shrink: 0;\n}\n.pj-dot.live { background: var(--accent-agent); animation: pl-pulse 1.6s ease infinite; }  /* (007 N-4) حي=أزرق وكيل نابض */\n.pj-dot.ok { background: var(--ok); }\n.pj-dot.gold { background: var(--accent); }\n.pj-dot.warn { background: var(--warn); }\n.pj-dot.danger { background: var(--danger); }\n@keyframes pl-pulse { 50% { opacity: .35; } }\n.pj-list-empty {\n  font-size: 12px; color: var(--text-faint);\n  padding: 8px 10px; line-height: 1.7;\n}\n\n/* ---------- تلميح الـcomposer (§33) ---------- */\n\n.composer-hint {\n  font-size: 11.5px; color: var(--text-faint);\n  line-height: 1.5;\n}\n\n/* ---------- مؤشر الانقطاع (§5 صحة الاتصال) ---------- */\n\nbody.live-disconnected .substrate-dot {\n  background: var(--danger) !important;\n}\n\n/* ---------- تجاوب (§30) ---------- */\n\n@media (max-width: 720px) {\n  .pl-scene { padding: 16px 12px 48px; }\n  .pl-avatar { display: none; }\n  .pl-head-title { max-width: 40%; }\n  .pl-stages { gap: 4px 10px; }\n  .pl-stage { font-size: 11.5px; }\n  .pl-actions .pl-btn { flex: 1; }\n}\n\n/* ==========================================================================\n   013.1 §18+§21+§22 — بطاقة بيئة التنفيذ + بطاقة التنفيذ الحية\n   وفشل منظم. نفس رموز التصميم — لا قيم سحرية.\n   ========================================================================== */\n\n.pl-env.ready .pl-title { color: var(--ok); }\n.pl-env.notready .pl-title { color: var(--accent); }\n.pl-env.notready { border-color: rgba(217,178,95,.35); }\n\n.pl-env-rows {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin: 8px 0 4px;\n}\n\n.pl-env-row {\n  display: flex;\n  gap: 6px;\n  font-size: 13px;\n  line-height: 1.7;\n  align-items: baseline;\n}\n\n.pl-env-k {\n  color: var(--text-dim);\n  flex-shrink: 0;\n  font-size: 12.5px;\n}\n\n.pl-env-v {\n  color: var(--text-mid);\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.pl-env-detected {\n  display: flex;\n  gap: 6px;\n  font-size: 12.5px;\n  color: var(--text-dim);\n  margin-top: 6px;\n}\n\n.pl-exec .pl-title { color: var(--ok); }\n\n.pl-exec-dot {\n  display: inline-block;\n  color: var(--ok);\n  animation: pl-exec-pulse 1.6s ease-in-out infinite;\n  margin-inline-end: 4px;\n}\n\n@keyframes pl-exec-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: .35; }\n}\n\n.pl-exec .pl-btn.danger { margin-inline-start: auto; }\n\n/* ================================================================\n * 013.2 — تجربة الـworkflow كمنتج: تدفق ماكرو + بيئة متماسكة\n * ================================================================ */\n\n/* (§8) تدفق المستخدم الماكرو: المحادثة ← الخطة ← الاعتماد ← تجهيز\n * البيئة ← التنفيذ ← المراجعة ← مكتمل — رقائق أفقية مترابطة */\n.pl-flow {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px 2px;\n  margin-top: 12px;\n  direction: rtl;\n}\n\n.pl-flow-step {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 11px;\n  border-radius: 999px;\n  font-size: 12.5px;\n  font-weight: 600;\n  border: 1px solid var(--border-soft);\n  color: var(--text-dim);\n  background: transparent;\n  white-space: nowrap;\n}\n\n.pl-flow-step .pl-flow-dot {\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 10px;\n  line-height: 1;\n  border: 1.5px solid currentColor;\n}\n\n.pl-flow-step.done {\n  color: var(--ok);\n  border-color: color-mix(in srgb, var(--ok) 40%, transparent);\n  background: color-mix(in srgb, var(--ok) 8%, transparent);\n}\n\n.pl-flow-step.active {\n  color: var(--accent);\n  border-color: color-mix(in srgb, var(--accent) 55%, transparent);\n  background: color-mix(in srgb, var(--accent) 10%, transparent);\n}\n\n.pl-flow-step.active .pl-flow-dot {\n  animation: pl-exec-pulse 1.4s ease-in-out infinite;\n}\n\n.pl-flow-step.waiting {\n  color: var(--accent);\n  border-color: color-mix(in srgb, var(--accent) 45%, transparent);\n  background: color-mix(in srgb, var(--accent) 8%, transparent);\n}\n\n.pl-flow-arrow {\n  color: var(--text-faint);\n  font-size: 11px;\n  margin-inline: 3px;\n}\n\n/* (§11) حلقة الفشل — تظهر عند الفشل فقط */\n.pl-failloop {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 10px;\n  padding: 8px 12px;\n  border-radius: 10px;\n  border: 1px dashed color-mix(in srgb, var(--danger) 45%, transparent);\n  background: color-mix(in srgb, var(--danger) 5%, transparent);\n}\n\n.pl-fail-step {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text-dim);\n}\n\n.pl-fail-step.hit { color: var(--danger); }\n.pl-fail-step.active { color: var(--accent); }\n\n.pl-fail-arrow {\n  color: var(--text-faint);\n  font-size: 11px;\n}\n\n/* (§7+§12) بطاقة البيئة المتماسكة + شريط التقدم */\n.pl-env.preparing .pl-title { color: var(--accent); }\n\n.pl-env-progress {\n  height: 8px;\n  border-radius: 999px;\n  background: var(--border-soft);\n  overflow: hidden;\n  margin-top: 10px;\n}\n\n.pl-env-progress-fill {\n  height: 100%;\n  border-radius: 999px;\n  background: linear-gradient(90deg,\n    color-mix(in srgb, var(--accent) 75%, var(--ok)),\n    var(--accent));\n  transition: width .6s ease;\n}\n\n.pl-env-progress-pct,\n.pl-env-progress-label {\n  font-size: 11.5px;\n  color: var(--text-dim);\n  margin-top: 5px;\n}\n\n/* (§2) المطلوب مقابل الفعلي — سطران مفصولان */\n.pl-env-reqact {\n  margin-top: 10px;\n  padding: 8px 10px;\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--text-dim) 6%, transparent);\n  border: 1px solid var(--border-soft);\n}\n\n/* (§4) فجوات بنيوية: need/detected/action — أسباب حرفية وأفعال */\n.pl-env-missing {\n  margin-top: 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.pl-env-gap {\n  padding: 8px 11px;\n  border-radius: 8px;\n  border-inline-start: 3px solid var(--danger);\n  background: color-mix(in srgb, var(--danger) 5%, transparent);\n}\n\n.pl-env-gap-need {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: var(--text-mid);\n}\n\n.pl-env-gap-detected,\n.pl-env-gap-action {\n  font-size: 12px;\n  color: var(--text-dim);\n  margin-top: 3px;\n}\n\n.pl-env-gap-action { color: var(--accent); }\n\n/* ==========================================================================\n   013.5 §N — تفاصيل الخطة: أقسام مسماة قابلة للطي على الثيم الداكن.\n\n   عطل التباين مُصلح من الجذر: كانت أسطح الخطة تُبنى فاتحة بلا رمز\n   (`var(--panel, #fff)` في control-center.css) بينما النص بلا لون\n   معلن يرث نص الثيم الفاتح (`--text` من styles.css) — أبيض على أبيض.\n   هنا: كل سطح داكن معلن، وكل نص بلون صريح، وRTL من المستند نفسه\n   (بلا `direction` قسري إلا حيث يجب)، ومقاييس مضغوطة + إفصاح تدريجي.\n   ========================================================================== */\n\n/* ---------- الأقسام المطوية ---------- */\n\n.pl-plan { gap: 8px; }\n.pl-plan .pl-head { align-items: center; gap: 8px; }\n\n.pl-sec {\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-s);\n  background: var(--bg);\n  overflow: hidden;\n}\n.pl-sec.open { border-color: var(--border); }\n\n.pl-sec-toggle {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 7px 11px;\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  color: var(--text-mid);\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 600;\n  text-align: start;\n  transition: background .15s var(--ease), color .15s var(--ease);\n}\n.pl-sec-toggle:hover { background: var(--bg-raised); color: var(--text); }\n.pl-sec.open .pl-sec-toggle { color: var(--accent); }\n\n.pl-sec-arrow {\n  color: var(--text-dim);\n  font-size: 10px;\n  flex-shrink: 0;\n}\n.pl-sec.open .pl-sec-arrow { color: var(--accent); }\n\n.pl-sec-label { flex: 1; min-width: 0; }\n\n.pl-sec-count {\n  flex-shrink: 0;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-dim);\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  border-radius: 999px;\n  padding: 0 8px;\n}\n.pl-sec.open .pl-sec-count {\n  color: var(--accent);\n  background: var(--accent-soft);\n  border-color: var(--accent-border);\n}\n\n.pl-sec-body {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px 11px 11px;\n  background: var(--bg-elevated);\n  border-top: 1px solid var(--border-soft);\n  color: var(--text);\n  max-height: 320px;\n  overflow-y: auto;\n  overflow-wrap: anywhere;\n  animation: pl-fade-in .2s var(--ease);\n}\n.pl-sec-body[hidden] { display: none !important; }\n\n/* ---------- صفوف ونصوص الأقسام (تباين عالٍ) ---------- */\n\n.pl-kv {\n  display: flex;\n  gap: 8px;\n  align-items: baseline;\n  font-size: 13px;\n  line-height: 1.75;\n}\n.pl-kv-k { flex-shrink: 0; font-size: 12.5px; color: var(--text-mid); }\n.pl-kv-v { min-width: 0; color: var(--text); }\n\n.pl-list { display: flex; flex-direction: column; gap: 4px; }\n.pl-list-item {\n  font-size: 12.8px;\n  line-height: 1.75;\n  color: var(--text-mid);\n  border-inline-start: 2px solid var(--border-strong);\n  padding-inline-start: 9px;\n}\n\n.pl-empty { font-size: 12.5px; line-height: 1.7; color: var(--text-dim); }\n\n.pl-phase-card {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 8px 10px;\n  border-radius: var(--radius-s);\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n}\n.pl-phase-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.pl-phase-name { color: var(--text); font-size: 13px; font-weight: 600; }\n.pl-phase-state {\n  flex-shrink: 0;\n  font-size: 11px;\n  color: var(--text-dim);\n  border: 1px solid var(--border-soft);\n  border-radius: 999px;\n  padding: 0 8px;\n  white-space: nowrap;\n}\n.pl-phase-sub { font-size: 12px; line-height: 1.7; color: var(--text-dim); }\n\n.pl-steps-group { display: flex; flex-direction: column; gap: 3px; }\n.pl-steps-group-title {\n  margin-top: 4px;\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--text);\n}\n.pl-step-row {\n  display: flex;\n  gap: 8px;\n  align-items: baseline;\n  font-size: 12.6px;\n  line-height: 1.7;\n}\n.pl-step-n {\n  flex-shrink: 0;\n  min-width: 26px;\n  font-size: 11.5px;\n  color: var(--accent);\n}\n.pl-step-text { min-width: 0; color: var(--text-mid); }\n.pl-step-state { flex-shrink: 0; font-size: 11px; color: var(--text-dim); }\n\n.pl-raw-body { margin-top: 0; }\n\n/* ---------- (007) سقطت طبقة ترقيع الأسطح الفاتحة — الجذر أُصلح في\n   control-center.css (نقي الرموز). تبقى القواعد الوظيفية غير الترقيعية: */\n\n.project-view .pl-card .pl-actions { flex-wrap: wrap; gap: 10px; }\n.project-view .pl-plan-live .pl-note { color: var(--text-dim); }\n\n/* (013.5 §J) بطاقة الانتظار الصادقة: رمز الحالة + نص ما يُنتظر + السقف.\n   ألوانها من رموز السمة الداكنة القائمة — لا لوحة جديدة. */\n.pl-wait-phase,\n.wf-wait-phase {\n  display: inline-block;\n  margin-inline-start: 8px;\n  padding: 2px 8px;\n  border-radius: var(--radius-s);\n  border: 1px solid var(--accent-border);\n  background: color-mix(in srgb, var(--accent) 12%, transparent);\n  color: var(--accent);\n  font-size: 11.5px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  direction: ltr;\n  unicode-bidi: isolate;\n}\n.pl-wait-text,\n.wf-planning-wait {\n  color: var(--text-mid);\n  font-size: 12.5px;\n  line-height: 1.6;\n  margin: 2px 0 8px;\n}\n.project-view .pl-wait-text,\n.project-view .wf-planning-wait { color: var(--text-mid); }\n.module-view .pl-wait-phase,\n.module-view .wf-wait-phase { color: var(--accent); }\n\n/* ==========================================================================\n   013.7 §P4 — بطاقة الخطة المعاد تصميمها (Dark RTL، لا JSON خام أساسي)\n   ========================================================================== */\n\n.pl-card.pl-plan {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-l);\n  overflow: hidden;\n}\n\n.pl-plan-head {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 16px 18px 8px;\n  border-bottom: 1px solid var(--border-soft);\n  background: var(--bg-sidebar);\n}\n\n.pl-plan-title-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.pl-plan-title {\n  font-weight: 600;\n  font-size: 15px;\n  color: var(--text);\n}\n\n.pl-plan-status {\n  font-size: 12px;\n  padding: 4px 12px;\n  border-radius: 999px;\n  white-space: nowrap;\n  font-weight: 600;\n}\n.pl-plan-status.ok { color: var(--ok); background: var(--ok-soft); }\n.pl-plan-status.gold { color: var(--accent); background: var(--accent-soft); }\n.pl-plan-status.danger { color: var(--danger); background: var(--danger-soft); }\n\n.pl-plan-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.pl-meta-chip {\n  font-size: 11.5px;\n  color: var(--text-mid);\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  border-radius: 999px;\n  padding: 2px 10px;\n  white-space: nowrap;\n}\n\n/* قسم الخطة */\n.pl-plan .pl-sec {\n  border-top: 1px solid var(--border-soft);\n}\n.pl-plan .pl-sec:first-child { border-top: none; }\n\n.pl-plan .pl-sec-toggle {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 12px 16px;\n  background: none;\n  border: none;\n  cursor: pointer;\n  text-align: start;\n  color: var(--text);\n  font-size: 13.5px;\n  font-weight: 600;\n}\n.pl-plan .pl-sec-toggle:hover { color: var(--accent); }\n.pl-plan .pl-sec-toggle:focus { outline: 2px solid var(--accent); outline-offset: -2px; }\n.pl-sec-arrow { font-size: 11px; transition: transform .2s var(--ease); }\n.pl-sec.open .pl-sec-arrow { transform: rotate(180deg); }\n.pl-sec-body { padding: 0 16px 12px; overflow: hidden; }\n.pl-sec.open .pl-sec-body { max-height: 1000px; transition: max-height .3s var(--ease); }\n\n/* الهدف */\n.pl-plan-objective {\n  font-size: 13.5px;\n  color: var(--text);\n  line-height: 1.7;\n  margin-bottom: 4px;\n  white-space: pre-wrap;\n}\n\n/* الملخص */\n.pl-plan-summary {\n  font-size: 13px;\n  color: var(--text-mid);\n  line-height: 1.7;\n  white-space: pre-wrap;\n}\n\n/* بطاقة المرحلة */\n.pl-phase-card {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 10px 12px;\n  border-radius: var(--radius-s);\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  margin-bottom: 6px;\n}\n\n.pl-phase-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 2px;\n}\n\n.pl-phase-index {\n  flex-shrink: 0;\n  width: 28px;\n  height: 28px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--accent);\n  background: var(--accent-soft);\n  border-radius: 50%;\n  border: 1px solid var(--accent-border);\n  flex-shrink: 0;\n}\n\n.pl-phase-name {\n  color: var(--text);\n  font-size: 13.5px;\n  font-weight: 600;\n  flex: 1;\n}\n\n.pl-phase-state {\n  flex-shrink: 0;\n  font-size: 11px;\n  color: var(--text-dim);\n  border: 1px solid var(--border-soft);\n  border-radius: 999px;\n  padding: 2px 10px;\n  white-space: nowrap;\n}\n.pl-phase-state.ok { color: var(--ok); border-color: rgba(127,185,138,.4); }\n.pl-phase-state.live { color: var(--accent); border-color: var(--accent-border); }\n\n.pl-phase-sub {\n  font-size: 12px;\n  line-height: 1.7;\n  color: var(--text-dim);\n  padding-inline-start: 36px;\n  margin-top: -2px;\n}\n\n.pl-phase-deps {\n  font-size: 12px;\n  color: var(--text-dim);\n  padding-inline-start: 36px;\n  margin-top: 2px;\n}\n.pl-phase-deps-label { color: var(--text-faint); }\n.pl-phase-deps-list { color: var(--text-mid); }\n\n.pl-phase-scope {\n  font-size: 12px;\n  color: var(--text-dim);\n  padding-inline-start: 36px;\n  margin-top: 2px;\n}\n.pl-phase-scope-label { color: var(--text-faint); }\n.pl-phase-scope-value { color: var(--text-mid); }\n\n/* الخطوات */\n.pl-steps-group {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin-top: 4px;\n}\n.pl-steps-group-title {\n  margin-top: 8px;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text);\n  padding-inline-start: 4px;\n  border-inline-start: 2px solid var(--accent-border);\n  padding-inline-start: 8px;\n}\n\n.pl-step-row {\n  display: flex;\n  gap: 8px;\n  align-items: baseline;\n  font-size: 12.6px;\n  line-height: 1.7;\n  padding: 2px 0 2px 36px;\n  border-inline-start: 2px solid var(--border-soft);\n  padding-inline-start: 10px;\n}\n.pl-step-n {\n  flex-shrink: 0;\n  min-width: 28px;\n  font-size: 11.5px;\n  color: var(--accent);\n  font-variant-numeric: tabular-nums;\n}\n.pl-step-text { min-width: 0; color: var(--text-mid); }\n.pl-step-state { flex-shrink: 0; font-size: 11px; color: var(--text-dim); }\n.pl-step-state.ok { color: var(--ok); }\n\n/* قسم الاعتماد */\n.pl-approval-done {\n  font-size: var(--fs-14);\n  font-weight: 600;\n  color: var(--ok);\n  padding: var(--sp-2) var(--sp-3);\n  background: var(--ok-soft);\n  border: 1px solid var(--ok-border);\n  border-radius: var(--radius-s);\n  margin-bottom: var(--sp-2);\n}\n\n.pl-plan-actions {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n  margin-top: 8px;\n}\n\n/* تفاصيل تقنية */\n.pl-tech-body {\n  margin-top: 8px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-s);\n  padding: 12px;\n  font-size: 11.5px;\n  color: var(--text-dim);\n  max-height: 300px;\n  overflow: auto;\n  font-family: var(--font-mono);\n  text-align: left;\n  white-space: pre-wrap;\n  direction: ltr;\n}\n\n/* فارغ */\n.pl-empty {\n  font-size: 13px;\n  color: var(--text-faint);\n  padding: 12px 16px;\n  line-height: 1.7;\n  text-align: center;\n}\n\n.pl-plan-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }\n\n/* خطوات المجموعة */\n.pl-steps-group {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  margin-top: 4px;\n}\n.pl-steps-group-title {\n  margin-top: 8px;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text);\n  padding-inline-start: 4px;\n  border-inline-start: 2px solid var(--accent-border);\n  padding-inline-start: 8px;\n}\n\n.pl-step-row {\n  display: flex;\n  gap: 8px;\n  align-items: baseline;\n  font-size: 12.6px;\n  line-height: 1.7;\n  padding: 2px 0 2px 36px;\n  border-inline-start: 2px solid var(--border-soft);\n  padding-inline-start: 10px;\n}\n.pl-step-n {\n  flex-shrink: 0;\n  min-width: 26px;\n  font-size: 11.5px;\n  color: var(--accent);\n  font-variant-numeric: tabular-nums;\n}\n.pl-step-text { min-width: 0; color: var(--text-mid); }\n.pl-step-state { flex-shrink: 0; font-size: 11px; color: var(--text-dim); }\n.pl-step-state.ok { color: var(--ok); }\n\n/* ---------- تجاوب الأقسام (§30) ---------- */\n\n@media (max-width: 720px) {\n  .pl-sec-toggle { padding: 7px 9px; font-size: 12.5px; }\n  .pl-sec-body { padding: 7px 9px 10px; max-height: 260px; }\n  .pl-kv { flex-direction: column; gap: 1px; }\n  .pl-plan-modal-head { flex-wrap: wrap; gap: 6px; }\n}\n\n"
