        "response": {
          "bodySize": 157,
          "content": {
            "mimeType": "text/html",
            "size": 157,
            "text": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Agentic Engineering System</title>\n  <link rel=\"stylesheet\" href=\"/static/fonts/fonts.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/theme.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/styles.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/projects.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/harness.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/live.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/app-shell.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/project-live.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/control-center.css?v=947e6e55\">\n  <link rel=\"stylesheet\" href=\"/static/factory-control.css?v=947e6e55\">\n</head>\n<body>\n  <!-- نظام الأيقونات الموحد (AES-UI-PREMIUM-REDESIGN-001): رموز خطية\n       متناسقة الأحجام والمعاني — بديل الرموز التعبيرية المتنافرة. -->\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n    <defs>\n      <symbol id=\"i-logo\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M12 2.5 20.5 7.25v9.5L12 21.5 3.5 16.75v-9.5L12 2.5z\"/>\n        <path d=\"M12 7.2 16.4 9.7v5L12 17.2 7.6 14.7v-5L12 7.2z\"/>\n        <circle cx=\"12\" cy=\"12\" r=\"1.1\" fill=\"currentColor\" stroke=\"none\"/>\n      </symbol>\n      <symbol id=\"i-chat\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M21 11.5a8.4 8.4 0 0 1-8.5 8.4 8.9 8.9 0 0 1-3.8-.8L3 21l1.9-5.2a8.3 8.3 0 0 1-.9-3.7A8.4 8.4 0 0 1 12.5 3.1a8.4 8.4 0 0 1 8.5 8.4z\"/>\n      </symbol>\n      <symbol id=\"i-task\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"/>\n      </symbol>\n      <symbol id=\"i-project\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M3 8.2 12 3.5l9 4.7v7.6L12 20.5 3 15.8V8.2z\"/><path d=\"M3 8.2l9 4.7 9-4.7M12 12.9v7.6\"/>\n      </symbol>\n      <symbol id=\"i-runs\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M2.5 12h4l2.5-7 4 14 2.5-7h6\"/>\n      </symbol>\n      <symbol id=\"i-factory\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M4 21V9l5 3.5V9l5 3.5V9l5 3.5V21H4z\"/><path d=\"M4 5.5h16M8 5.5V3M16 5.5V3\"/>\n      </symbol>\n      <symbol id=\"i-archive\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"3\" y=\"4\" width=\"18\" height=\"4.5\" rx=\"1\"/><path d=\"M4.8 8.5V20a1 1 0 0 0 1 1h12.4a1 1 0 0 0 1-1V8.5M9.5 12.5h5\"/>\n      </symbol>\n      <symbol id=\"i-settings\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <circle cx=\"12\" cy=\"12\" r=\"3.2\"/>\n        <path d=\"M19.4 15a1.6 1.6 0 0 0 .32 1.77l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.6 1.6 0 0 0-1.77-.32 1.6 1.6 0 0 0-1 1.47V21a2 2 0 1 1-4 0v-.09A1.6 1.6 0 0 0 9.1 19.4a1.6 1.6 0 0 0-1.77.32l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.6 1.6 0 0 0 .32-1.77 1.6 1.6 0 0 0-1.47-1H3a2 2 0 1 1 0-4h.09A1.6 1.6 0 0 0 4.6 9.1a1.6 1.6 0 0 0-.32-1.77l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.6 1.6 0 0 0 1.77.32H9.1a1.6 1.6 0 0 0 1-1.47V3a2 2 0 1 1 4 0v.09a1.6 1.6 0 0 0 1 1.47 1.6 1.6 0 0 0 1.77-.32l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.6 1.6 0 0 0-.32 1.77V9.1a1.6 1.6 0 0 0 1.47 1H21a2 2 0 1 1 0 4h-.09a1.6 1.6 0 0 0-1.51 1z\"/>\n      </symbol>\n      <symbol id=\"i-new\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n        <path d=\"M12 5v14M5 12h14\"/>\n      </symbol>\n      <symbol id=\"i-plus\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n        <path d=\"M12 5v14M5 12h14\"/>\n      </symbol>\n      <symbol id=\"i-send\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M22 2 11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/>\n      </symbol>\n      <symbol id=\"i-web\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\">\n        <circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a14.5 14.5 0 0 1 0 18M12 3a14.5 14.5 0 0 0 0 18\"/>\n      </symbol>\n      <symbol id=\"i-back\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n      </symbol>\n      <symbol id=\"i-forward\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n      </symbol>\n      <symbol id=\"i-close\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n        <path d=\"M18 6 6 18M6 6l12 12\"/>\n      </symbol>\n      <symbol id=\"i-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M20 6 9 17l-5-5\"/>\n      </symbol>\n      <symbol id=\"i-alert\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4M12 17h.01\"/>\n      </symbol>\n      <symbol id=\"i-info\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\">\n        <circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 16v-4.5M12 8h.01\"/>\n      </symbol>\n      <symbol id=\"i-stop\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\">\n        <rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"1.5\"/>\n      </symbol>\n      <symbol id=\"i-collapse\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M9 4h11M9 12h11M9 20h11M4 4v0.01M4 12v0.01M4 20v0.01\"/>\n      </symbol>\n      <symbol id=\"i-chevron-d\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"m6 9 6 6 6-6\"/>\n      </symbol>\n      <symbol id=\"i-terminal\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"m5 8 4 4-4 4M12 16h7\"/>\n      </symbol>\n      <symbol id=\"i-file\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M14 2.5H6.5A1.5 1.5 0 0 0 5 4v16a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 20V7.5L14 2.5z\"/><path d=\"M14 2.5v5h5\"/>\n      </symbol>\n    </defs>\n  </svg>\n\n  <div class=\"app\">\n\n    <!-- الشريط الجانبي: هوية النظام والتنقل -->\n    <aside class=\"sidebar\" id=\"sidebar\">\n      <div class=\"sidebar-head\">\n        <span class=\"brand\">\n          <span class=\"brand-mark icon lg\"><svg><use href=\"#i-logo\"/></svg></span>\n          <span class=\"brand-text\">\n            <span class=\"brand-name\">Agentic Engineering</span>\n            <span class=\"brand-sub\">System</span>\n          </span>\n        </span>\n        <button class=\"icon-btn\" id=\"sidebar-collapse\" title=\"طي الشريط\">\n          <span class=\"icon\"><svg><use href=\"#i-forward\"/></svg></span>\n        </button>\n      </div>\n\n      <button class=\"new-chat\" id=\"new-chat\" title=\"بدء محادثة جديدة\">\n        <span class=\"icon sm\"><svg><use href=\"#i-new\"/></svg></span>\n        <span>محادثة جديدة</span>\n      </button>\n\n      <!-- التنقل الأساسي: محادثة/تشغيلات/مصنع/أرشيف -->\n      <nav class=\"side-nav\" id=\"side-nav\" aria-label=\"التنقل الأساسي\">\n        <button class=\"side-nav-item\" data-nav=\"chat\" title=\"المحادثات\">\n          <span class=\"icon\"><svg><use href=\"#i-chat\"/></svg></span>\n          <span class=\"side-nav-label\">المحادثات</span>\n        </button>\n        <button class=\"side-nav-item\" data-nav=\"runs\" title=\"التشغيلات النشطة\">\n          <span class=\"icon\"><svg><use href=\"#i-runs\"/></svg></span>\n          <span class=\"side-nav-label\">التشغيلات</span>\n          <em class=\"nav-badge\" id=\"runs-badge\" hidden></em>\n        </button>\n        <button class=\"side-nav-item\" data-nav=\"factory\" title=\"غرفة التحكم بالمصنع\">\n          <span class=\"icon\"><svg><use href=\"#i-factory\"/></svg></span>\n          <span class=\"side-nav-label\">مصنع الوكلاء</span>\n        </button>\n        <button class=\"side-nav-item\" data-nav=\"archive\" title=\"المشاريع المؤرشفة\">\n          <span class=\"icon\"><svg><use href=\"#i-archive\"/></svg></span>\n          <span class=\"side-nav-label\">الأرشيف</span>\n        </button>\n      </nav>\n\n      <nav class=\"conversations\" id=\"conversations\" aria-label=\"قائمة المحادثات\">\n        <div class=\"conv-empty\" id=\"conv-empty\">لا محادثات بعد</div>\n      </nav>\n\n      <!-- المشاريع — الكيان الأول في النظام -->\n      <div class=\"projects-side\" id=\"projects-side\">\n        <div class=\"side-section-head\">\n          <span>المشاريع</span>\n          <button class=\"icon-btn\" id=\"project-new\" title=\"مشروع جديد — هدف ← خطة ← تنفيذ ذاتي ← أدلة\">\n            <span class=\"icon sm\"><svg><use href=\"#i-plus\"/></svg></span>\n          </button>\n        </div>\n        <nav class=\"projects-list\" id=\"projects-list\" aria-label=\"قائمة المشاريع\"></nav>\n      </div>\n\n      <div class=\"sidebar-foot\">\n        <span class=\"substrate-dot\" id=\"substrate-dot\" title=\"\"></span>\n        <span class=\"substrate-label\" id=\"substrate-label\">الركيزة: …</span>\n        <button class=\"icon-btn gear\" id=\"settings-open\" title=\"الإعدادات: المزودون والنماذج والقدرات وبيئات التنفيذ\">\n          <span class=\"icon\"><svg><use href=\"#i-settings\"/></svg></span>\n        </button>\n      </div>\n    </aside>\n\n    <!-- عمود المحادثة -->\n    <main class=\"chat\">\n      <header class=\"chat-head\">\n        <button class=\"icon-btn sidebar-toggle\" id=\"sidebar-toggle\" title=\"إظهار/إخفاء المحادثات\">\n          <span class=\"icon\"><svg><use href=\"#i-collapse\"/></svg></span>\n        </button>\n        <span class=\"chat-title\" id=\"chat-title\">محادثة جديدة</span>\n        <span class=\"mode-badge\" id=\"mode-badge\" hidden></span>\n      </header>\n\n      <div class=\"chat-scroll\" id=\"chat-scroll\">\n\n        <!-- شاشة البداية (007): بطل مُهيكل — بطاقة اقتراح بعنوان ووصف -->\n        <section class=\"welcome\" id=\"welcome\">\n          <div class=\"welcome-mark icon lg\"><svg><use href=\"#i-logo\"/></svg></div>\n          <h1>كيف أساعدك اليوم؟</h1>\n          <p class=\"tagline\">اكتب رسالة للمحادثة المباشرة، أو ابدأ مهمة كاملة ليعمل فريق الوكلاء على هدفك بخطوات وأدلة مرئية.</p>\n          <div class=\"suggestions\">\n            <button class=\"suggestion\" data-mode=\"chat\">\n              <span class=\"icon sm\"><svg><use href=\"#i-chat\"/></svg></span>\n              <span class=\"suggestion-text\">\n                <span class=\"suggestion-title\">محادثة سريعة</span>\n                <span class=\"suggestion-desc\">نموذج واحد يجيب فورًا داخل هذه النافذة</span>\n              </span>\n            </button>\n            <button class=\"suggestion\" data-mode=\"task\">\n              <span class=\"icon sm\"><svg><use href=\"#i-task\"/></svg></span>\n              <span class=\"suggestion-text\">\n                <span class=\"suggestion-title\">مهمة كاملة</span>\n                <span class=\"suggestion-desc\">تخطيط وتنفيذ وتحقق وتحكيم بإثبات لكل خطوة</span>\n              </span>\n            </button>\n          </div>\n        </section>\n\n        <!-- الرسائل -->\n        <div class=\"messages\" id=\"messages\"></div>\n\n        <!-- زر متابعة الأسفل — يظهر عند صعود المالك للقراءة -->\n        <button id=\"follow-btn\" class=\"follow-btn\" hidden title=\"العودة إلى آخر حدث\">\n          <span class=\"icon sm\"><svg><use href=\"#i-chevron-d\"/></svg></span>\n          <span>متابعة</span>\n        </button>\n      </div>\n\n      <!-- عرض المشروع — تجربة محادثة حية -->\n      <section class=\"project-view\" id=\"project-view\" hidden>\n        <header class=\"pl-head-bar\" id=\"pl-head-bar\">\n          <button class=\"icon-btn\" id=\"pl-back\" title=\"عودة للمحادثة\">\n            <span class=\"icon\"><svg><use href=\"#i-back\"/></svg></span>\n          </button>\n          <span class=\"pl-head-title\" id=\"pl-head-title\">مشروع</span>\n          <span class=\"pl-head-status dim\" id=\"pl-head-status\">…</span>\n          <span class=\"pl-head-meta\" id=\"pl-head-meta\"></span>\n          <span class=\"pl-actions\" id=\"pl-actions\"></span>\n        </header>\n        <nav class=\"pl-tabs\" id=\"pl-tabs\" aria-label=\"أقسام المشروع\">\n          <button class=\"pl-tab active\" data-tab=\"conversation\">المحادثة</button>\n          <button class=\"pl-tab\" data-tab=\"overview\">النظرة العامة</button>\n          <button class=\"pl-tab\" data-tab=\"workflow\">سير العمل</button>\n          <button class=\"pl-tab\" data-tab=\"evidence\">الأدلة</button>\n          <button class=\"pl-tab\" data-tab=\"artifacts\">المخرجات</button>\n          <button class=\"pl-tab\" data-tab=\"history\">التاريخ</button>\n        </nav>\n        <div class=\"pl-scroll\">\n          <div class=\"pl-scene\" id=\"pl-scene\"></div>\n          <div class=\"pl-tab-body\" id=\"pl-tab-body\" hidden></div>\n        </div>\n      </section>\n\n      <!-- مركز التحكم: التشغيلات النشطة -->\n      <section class=\"cc-view\" id=\"runs-view\" hidden>\n        <header class=\"cc-head\">\n          <button class=\"icon-btn\" id=\"runs-back\" title=\"عودة للمحادثة\">\n            <span class=\"icon\"><svg><use href=\"#i-back\"/></svg></span>\n          </button>\n          <span class=\"cc-title\">التشغيلات النشطة</span>\n          <span class=\"cc-sub\">العمل المستمر مرئي حتى بعد مغادرة المشروع</span>\n        </header>\n        <div class=\"cc-scroll\"><div class=\"cc-body\" id=\"runs-body\"></div></div>\n      </section>\n\n      <!-- الأرشيف -->\n      <section class=\"cc-view\" id=\"archive-view\" hidden>\n        <header class=\"cc-head\">\n          <button class=\"icon-btn\" id=\"archive-back\" title=\"عودة للمحادثة\">\n            <span class=\"icon\"><svg><use href=\"#i-back\"/></svg></span>\n          </button>\n          <span class=\"cc-title\">الأرشيف</span>\n          <span class=\"cc-sub\">المشاريع المؤرشفة تبقى كاملة وقابلة للاسترجاع</span>\n        </header>\n        <div class=\"cc-scroll\"><div class=\"cc-body\" id=\"archive-body\"></div></div>\n      </section>\n\n      <!-- غرفة التحكم بالمصنع -->\n      <section class=\"cc-view\" id=\"factory-view\" hidden>\n        <header class=\"cc-head\">\n          <button class=\"icon-btn\" id=\"factory-back\" title=\"عودة للمحادثة\">\n            <span class=\"icon\"><svg><use href=\"#i-back\"/></svg></span>\n          </button>\n          <span class=\"cc-title\">غرفة التحكم بالمصنع</span>\n          <span class=\"cc-sub\" id=\"factory-system-status\">SYSTEM: DISCONNECTED</span>\n        </header>\n        <div class=\"cc-scroll\"><div class=\"cc-body\" id=\"factory-body\"></div></div>\n      </section>\n\n      <!-- إعدادات المهمة (نمط المهمة فقط) — قابلة للطي -->\n      <div class=\"task-settings\" id=\"task-settings\" hidden>\n        <button class=\"task-settings-toggle\" id=\"task-settings-toggle\">إعدادات المهمة <span class=\"caret\">▾</span></button>\n        <div class=\"task-settings-body\" id=\"task-settings-body\" hidden></div>\n      </div>\n\n      <!-- صندوق الإرسال -->\n      <div class=\"composer\">\n        <div class=\"composer-inner\">\n          <button id=\"send\" title=\"إرسال\" aria-label=\"إرسال\" disabled>\n            <span class=\"icon\"><svg><use href=\"#i-send\"/></svg></span>\n          </button>\n          <textarea id=\"input\" rows=\"1\" placeholder=\"اكتب رسالتك…\" aria-label=\"رسالتك\"></textarea>\n          <div class=\"plus-wrap\">\n            <button id=\"plus\" title=\"اختر النمط: محادثة أو مهمة\" aria-label=\"اختيار النمط\">\n              <span class=\"icon\"><svg><use href=\"#i-plus\"/></svg></span>\n            </button>\n            <div class=\"plus-menu\" id=\"plus-menu\" hidden>\n              <button class=\"plus-option\" data-mode=\"chat\">\n                <span class=\"icon sm\"><svg><use href=\"#i-chat\"/></svg></span>\n                <span>محادثة</span>\n              </button>\n              <button class=\"plus-option\" data-mode=\"task\">\n                <span class=\"icon sm\"><svg><use href=\"#i-task\"/></svg></span>\n                <span>مهمة</span>\n              </button>\n              <button class=\"plus-option\" data-mode=\"project\">\n                <span class=\"icon sm\"><svg><use href=\"#i-project\"/></svg></span>\n                <span>مشروع</span>\n              </button>\n            </div>\n          </div>\n          <button id=\"web-toggle\" class=\"web-toggle auto\" title=\"البحث في الويب: تلقائي — يتغير لكشف نية الرسالة\">\n            <span class=\"icon\"><svg><use href=\"#i-web\"/></svg></span>\n          </button>\n        </div>\n        <div class=\"composer-foot\">\n          <span class=\"mode-chip\" id=\"mode-chip\" title=\"النمط الحالي — غيّره من زر الإضافة\">محادثة</span>\n          <span class=\"composer-hint\" id=\"composer-hint\" hidden></span>\n          <span class=\"composer-shortcut\">Enter للإرسال · Shift+Enter لسطر جديد</span>\n          <button id=\"stop-run\" class=\"stop-btn\" hidden title=\"إيقاف فوري آمن — يُكرَّم عند أقرب حدّ آمن مع حفظ الحالة\">\n            <span class=\"icon sm\"><svg><use href=\"#i-stop\"/></svg></span>\n            <span>إيقاف</span>\n          </button>\n        </div>\n      </div>\n    </main>\n\n  </div>\n\n  <!-- حدود الأخطاء العامة -->\n  <div class=\"error-boundary\" id=\"error-boundary\" hidden></div>\n\n  <!-- لوحة الإعدادات الجانبية -->\n  <div class=\"drawer-backdrop\" id=\"drawer-backdrop\" hidden></div>\n  <aside class=\"drawer\" id=\"settings-drawer\" hidden aria-label=\"الإعدادات\">\n    <div class=\"drawer-head\">\n      <span class=\"drawer-title\">\n        <span class=\"icon sm\"><svg><use href=\"#i-settings\"/></svg></span>\n        <span>الإعدادات</span>\n      </span>\n      <button class=\"icon-btn\" id=\"settings-close\" title=\"إغلاق (Esc)\">\n        <span class=\"icon\"><svg><use href=\"#i-close\"/></svg></span>\n      </button>\n    </div>\n\n    <nav class=\"settings-tabs\" id=\"settings-tabs\" aria-label=\"أقسام الإعدادات\">\n      <button class=\"settings-tab active\" data-tab=\"general\">عام</button>\n      <button class=\"settings-tab\" data-tab=\"providers\">المزودون</button>\n      <button class=\"settings-tab\" data-tab=\"models\">النماذج</button>\n      <button class=\"settings-tab\" data-tab=\"tools\">الأدوات والقدرات</button>\n      <button class=\"settings-tab\" data-tab=\"execution\">بيئات التنفيذ</button>\n      <button class=\"settings-tab\" data-tab=\"advanced\">متقدم</button>\n    </nav>\n\n    <div class=\"drawer-body\">\n\n      <section class=\"drawer-section tab-panel active\" id=\"tab-general\">\n        <h3>عام</h3>\n        <p class=\"drawer-note\">حالة النظام والركيزة وبيئة التنفيذ الفعالة — بلا أسرار.</p>\n        <div id=\"general-body\" class=\"general-body\"></div>\n      </section>\n\n      <section class=\"drawer-section tab-panel\" id=\"tab-providers\" hidden>\n        <h3>المزودون والاتصال</h3>\n        <p class=\"drawer-note\">إدارة كاملة من هنا: أضف مزودًا، عدّل Base URL، أضف تكوينات، واختبر الاتصال — المفاتيح محلية ولا تُعاد أبدًا.</p>\n        <div id=\"providers-body\"></div>\n      </section>\n\n      <section class=\"drawer-section tab-panel\" id=\"tab-models\" hidden>\n        <h3>إعدادات النماذج</h3>\n        <p class=\"drawer-note\">لكل دور نموذجه المستقل — لا دور يرث مزود دور آخر.</p>\n        <div id=\"role-models\"></div>\n        <button class=\"btn primary\" id=\"models-save\">حفظ اختيارات النماذج</button>\n        <div class=\"save-result\" id=\"models-save-result\"></div>\n      </section>\n\n      <section class=\"drawer-section tab-panel\" id=\"tab-tools\" hidden>\n        <h3>الأدوات والقدرات</h3>\n        <p class=\"drawer-note\">جرد حقيقي لقدرات النظام قبل أي مهمة — لا «جاهز» بلا مسبار فعلي، والجاهزية تنتهي صلاحيتها. البحث قدرة قابلة للتوفير: DDG مهلة ≠ الإنترنت مقطوع.</p>\n        <div class=\"env-summary\" id=\"env-summary\"></div>\n        <div class=\"pv-row\">\n          <button class=\"pv-btn primary\" id=\"env-run-all\">فحص كامل للبيئة</button>\n          <button class=\"pv-btn\" id=\"env-inventory\">جرد البيئة (OS/شبكة/أدوات)</button>\n        </div>\n        <div class=\"env-note\" id=\"env-note\"></div>\n        <div class=\"env-inventory-body\" id=\"env-inventory-body\" hidden></div>\n        <div class=\"cap-grid\" id=\"env-caps\"></div>\n        <h4 class=\"research-head\">مزودو البحث</h4>\n        <p class=\"drawer-note\">ابحث عبر أول مزود جاهز — جهّز SearXNG (رابط) أو Search API (نقطة+مفتاح) عند تعطل DDG.</p>\n        <div id=\"research-providers\"></div>\n      </section>\n\n      <section class=\"drawer-section tab-panel\" id=\"tab-execution\" hidden>\n        <h3>بيئات التنفيذ</h3>\n        <p class=\"drawer-note\">المسبار والمنفذ من مصدر واحد — بيئة جاهزة فقط بعد فحوص إقلاع/كتابة/تنفيذ/التقاط حقيقية. للتنفيذ على Linux/WSL2: شغّل العامل ثم أضف بيئة REMOTE_WORKER.</p>\n        <div id=\"exec-env-body\"></div>\n        <div id=\"exec-env-add\" class=\"exec-env-add\"></div>\n      </section>\n\n      <section class=\"drawer-section tab-panel advanced\" id=\"tab-advanced\" hidden>\n        <h3>أدوات متقدمة</h3>\n        <p class=\"drawer-note\">مسارات تشخيصية ومتخصصة للمستخدم المتقدم.</p>\n        <div class=\"advanced-grid\">\n          <button class=\"btn ghost\" id=\"eoe-run\" title=\"تنفيذ أمر تنفيذي كامل: المنح والدفع ينتظران موافقتك\">تنفيذ أمر تنفيذي</button>\n          <button class=\"btn ghost\" id=\"router-demo\" title=\"عرض أحداث الموجّه: حد المعدل والتبريد والتبدل\">أحداث الموجّه</button>\n          <button class=\"btn ghost\" id=\"mission-run\" title=\"المهمة الحية المتخصصة: تقرير جيوسياسي + PDF عربي\">المهمة الحية المتخصصة</button>\n          <button class=\"btn ghost\" id=\"build-run\" title=\"مهمة البناء: حزمة textstats وتدفعها إلى فرعها ببطاقتي موافقة\">مهمة البناء textstats</button>\n        </div>\n      </section>\n\n    </div>\n  </aside>\n\n  <!-- نافذة تفاصيل الحدث: الـ JSON الكامل -->\n  <div class=\"modal-backdrop\" id=\"modal-backdrop\" hidden>\n    <div class=\"modal\" role=\"dialog\" aria-label=\"تفاصيل الحدث\">\n      <div class=\"modal-head\">\n        <span id=\"modal-title\">تفاصيل الحدث</span>\n        <button id=\"modal-copy\" class=\"btn ghost small\" title=\"نسخ الـJSON الخام\">نسخ JSON</button>\n        <button id=\"modal-close\" class=\"icon-btn\" title=\"إغلاق (Esc)\">\n          <span class=\"icon\"><svg><use href=\"#i-close\"/></svg></span>\n        </button>\n      </div>\n      <pre id=\"modal-json\" dir=\"ltr\"></pre>\n    </div>\n  </div>\n\n  <script src=\"/static/markdown.js?v=947e6e55\"></script>\n  <script src=\"/static/app.js?v=947e6e55\"></script>\n  <script src=\"/static/chat-stream.js?v=947e6e55\"></script>\n  <script src=\"/static/task-cards.js?v=947e6e55\"></script>\n  <script src=\"/static/model-picker.js?v=947e6e55\"></script>\n  <script src=\"/static/error-boundary.js?v=947e6e55\"></script>\n  <script src=\"/static/settings.js?v=947e6e55\"></script>\n  <script src=\"/static/environment.js?v=947e6e55\"></script>\n  <script src=\"/static/research-ui.js?v=947e6e55\"></script>\n  <script src=\"/static/execution-env.js?v=947e6e55\"></script>\n  <script src=\"/static/harness.js?v=947e6e55\"></script>\n  <script src=\"/static/live-events.js?v=947e6e55\"></script>\n  <script src=\"/static/project-live.js?v=947e6e55\"></script>\n  <script src=\"/static/workflow-view.js?v=947e6e55\"></script>\n  <script src=\"/static/control-center.js?v=947e6e55\"></script>\n  <script src=\"/static/projects.js?v=947e6e55\"></script>\n  <script src=\"/static/factory-control.js?v=947e6e55\"></script>\n</body>\n</html>\n"
