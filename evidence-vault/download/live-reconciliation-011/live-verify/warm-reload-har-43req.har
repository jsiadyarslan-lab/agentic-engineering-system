        "response": {
          "bodySize": 0,
          "content": {
            "mimeType": "text/css",
            "size": 0,
            "text": "/* FACTORY CONTROL ROOM — أنماط غرفة التحكم بالمصنع (E2-UI).\n * ==========================================================================\n * AES-UI-PREMIUM-REDESIGN-003 أسس المفردات البنائية؛ و007 أعاد\n * تأسيس موادها من نظام theme.css الموحد — scoped بالكامل داخل #factory-view:\n *   • الرموز اللونية نفسها (--bg #0b0e14 … --acc #58a6ff) دون تعديل.\n *   • الخط: IBM Plex Sans Arabic + IBM Plex Mono (مضمنان محلياً).\n *   • الأنصاف 8/12/16، الظل، شريط التمرير، التحديد، التركيز — كما في المرجع.\n *   • البطاقات برؤوس card-h، التبويبات بخط سفلي، الوسوم أحادية العرض،\n *     الأزرار pri، صفوف بلا حدود مع تحويم هادئ، نقاط حالات نابضة.\n * لا يمتد أي من هذا إلى بقية التطبيق (المحادثة/الإعدادات/المشاريع)\n * ولا إلى أسطح التشغيلات/الأرشيف (control-center.css).\n * ========================================================================== */\n\n/* ---------- 1) الرموز — (007) أعيد تأسيسها من النظام الموحد ----------\n * القرار الموثق: مفردات 003 البنائية تبقى (بطاقات برؤوس card-h،\n * تبويبات بخط سفلي، وسوم أحادية، notice بحافة داخلية، نقاط نابضة)\n * لكن موادها من theme.css وحدها — فينتهي كون المصنع جزيرة لوحة\n * ثانية: الأسطح فحمية النظام، والأزرق #58A6FF يبقى بصفته دلالة\n * «حيوية وكيل» المسماة (--accent-agent) لا لوحة موازية. */\n#factory-view {\n  /* الأسطح/النصوص/الحالات ذات الأسماء العالمية (--bg/--text/--ok/…) لا\n   * تُعاد تعريفها هنا إطلاقًا — تُوَّرث من :root مباشرة (تعريفها محليًا\n   * كان سيسبب دورة مرجعية). هنا فقط أسماء المصنع الخاصة، تُعرَّف\n   * بقيم من النظام: */\n  --s1: var(--bg-raised);\n  --s2: var(--bg-elevated);\n  --s3: var(--bg-hover);\n  --line: var(--border-soft);\n  --line2: var(--border);\n  --mut: var(--text-mid);\n  --dim: var(--text-dim);\n  --err: var(--danger);\n  /* تمييز الوكيل/الحيوية — الرمز الدلالي النظامي */\n  --acc: var(--accent-agent);\n  --acc-ink: #04101c;\n  --acc-soft: var(--accent-agent-soft);\n  --acc-hi: #bcd9ff;\n  /* الهندسة من النظام: أنصاف ومسافات وخط وظل موحدة */\n  --r-s: 8px;\n  --r-m: var(--radius-m);\n  --r-l: var(--radius-l);\n  --shadow: var(--shadow-2);\n  --mono: var(--font-mono);\n\n  background: var(--bg);\n  color: var(--text);\n  font-size: var(--fs-15);\n  line-height: 1.75;\n}\n\n#factory-view ::selection {\n  background: rgba(212, 172, 85, 0.28);\n  color: var(--text);\n}\n#factory-view :focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n  border-radius: var(--radius-s);\n}\n#factory-view ::-webkit-scrollbar { width: 9px; height: 9px; }\n#factory-view ::-webkit-scrollbar-thumb {\n  background: #2C3640;\n  border-radius: 99px;\n  border: 2px solid var(--bg);\n}\n#factory-view ::-webkit-scrollbar-thumb:hover { background: #3A4550; }\n#factory-view ::-webkit-scrollbar-track { background: transparent; }\n\n/* ---------- 2) رأس الغرفة — موحد مع رؤوس cc-head (007) ---------- */\n#factory-view .cc-head {\n  gap: var(--sp-2);\n  padding: 10px var(--sp-4);\n  background: var(--bg-sidebar);\n  border-bottom: 1px solid var(--border-soft);\n}\n#factory-view .cc-title {\n  font-size: var(--fs-15);\n  font-weight: 600;\n  color: var(--text);\n}\n#factory-view .cc-sub,\n#factory-system-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  border-radius: 99px;\n  padding: 4px 10px;\n  font-size: 11px;\n  font-weight: 500;\n  font-family: var(--mono);\n  color: var(--acc-hi);\n  background: var(--acc-soft);\n  border: 1px solid var(--accent-agent-border);\n}\n#factory-system-status::before {\n  content: \"\";\n  width: 6px;\n  height: 6px;\n  border-radius: 99px;\n  background: var(--acc);\n  animation: fc-pulse 1.4s infinite;\n  flex: none;\n}\n#factory-system-status.bad {\n  color: var(--err);\n  background: var(--danger-chip);\n  border-color: var(--danger-border);\n}\n#factory-system-status.bad::before {\n  background: var(--err);\n  animation: none;\n}\n\n/* زر أيقوني — .ibtn المرجعي */\n#factory-view .icon-btn {\n  width: 32px;\n  height: 32px;\n  flex: none;\n  display: grid;\n  place-items: center;\n  background: none;\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  color: var(--mut);\n  cursor: pointer;\n  transition: 0.15s;\n  padding: 0;\n}\n#factory-view .icon-btn:hover {\n  color: var(--text);\n  border-color: var(--line2);\n  background: var(--s2);\n}\n#factory-view .icon-btn .icon,\n#factory-view .icon-btn svg {\n  width: 15px;\n  height: 15px;\n}\n\n/* ---------- 3) عمود المحتوى — .col المرجعي (780px وسط) ---------- */\n#factory-view .cc-body {\n  max-width: none;\n  margin: 0;\n  padding: 0;\n  display: block;\n  background: transparent;\n}\n.factory-overview,\n.factory-create-mission,\n.factory-mission-view {\n  max-width: 780px;\n  margin-inline: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  padding: 26px 22px 44px;\n}\n/* انحراف وظيفي واحد موثق: عرض التشغيل ثلاثي اللوحات أوسع قليلاً من\n * عمود المحادثة كي تبقى لوحات التسلسل/الرسم/الوكيل قابلة للقراءة. */\n.factory-run-view {\n  max-width: 1080px;\n  margin-inline: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  padding: 22px 22px 44px;\n}\n\n/* ---------- 4) البطاقات — .card/.card-h المرجعية ---------- */\n.fc-card {\n  background: var(--s1);\n  border: 1px solid var(--line);\n  border-radius: var(--r-l);\n  overflow: hidden;\n  margin: 0;\n  padding: 0;\n}\n.fc-card h3 {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 16px;\n  background: var(--s2);\n  border-bottom: 1px solid var(--line);\n  margin: 0;\n  font-size: 13.5px;\n  font-weight: 700;\n  color: var(--text);\n}\n.fc-card > *:not(h3) { padding-inline: 16px; }\n.fc-card > .fc-mission-tabs { margin: 0; padding: 0 8px; }\n.fc-card > :last-child { padding-bottom: 16px; }\n.fc-card > .fc-mission-tabs { padding-bottom: 0; }\n.fc-card h4 {\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--mut);\n  margin: 0 0 10px;\n}\n\n/* ---------- 5) الإحصاءات — بلاطات pcard ---------- */\n.fc-grid-2 {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  padding: 16px;\n}\n.fc-grid-3 {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: 14px;\n}\n.fc-stat {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 12px 14px;\n  background: var(--s2);\n  border: 1px solid var(--line);\n  border-radius: var(--r-m);\n}\n.fc-stat-label {\n  font-size: 11px;\n  color: var(--dim);\n  letter-spacing: 0.04em;\n}\n.fc-stat-value {\n  font-size: 16px;\n  font-weight: 500;\n  color: var(--text);\n  font-family: var(--mono);\n  line-height: 1.4;\n}\n.fc-stat-value.ok { color: var(--ok); }\n.fc-stat-value.bad { color: var(--err); }\n.fc-stat-value.warn { color: var(--warn); }\n\n/* ---------- 6) الوسوم — .tag المرجعي (أحادي العرض) ---------- */\n.fc-run-status,\n.fc-mission-status {\n  font-family: var(--mono);\n  font-size: 9.5px;\n  letter-spacing: 0.06em;\n  border-radius: 6px;\n  padding: 2px 7px;\n  flex: none;\n  margin-inline-start: auto;\n  color: var(--mut);\n  background: var(--s1);\n  border: 1px solid var(--line);\n  white-space: nowrap;\n}\n.fc-run-status.ok,\n.fc-mission-status.ok {\n  color: var(--ok);\n  background: var(--ok-chip);\n  border-color: var(--ok-border);\n}\n.fc-run-status.bad,\n.fc-mission-status.bad {\n  color: var(--err);\n  background: var(--danger-chip);\n  border-color: var(--danger-border);\n}\n.fc-run-status.warn,\n.fc-mission-status.warn {\n  color: var(--warn);\n  background: var(--warn-soft);\n  border-color: var(--warn-border);\n}\n\n/* شارة مباشرة — .pill.run المرجعي بنقطة نابضة */\n.fc-run-live-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  border-radius: 99px;\n  padding: 4px 10px;\n  font-size: 11px;\n  font-weight: 600;\n  font-family: var(--mono);\n  color: var(--mut);\n  background: var(--s1);\n  border: 1px solid var(--line);\n  flex: none;\n}\n.fc-run-live-badge.live {\n  color: var(--acc-hi);\n  background: var(--acc-soft);\n  border-color: var(--accent-agent-border);\n}\n.fc-run-live-badge.live::before {\n  content: \"\";\n  width: 6px;\n  height: 6px;\n  border-radius: 99px;\n  background: var(--acc);\n  animation: fc-pulse 1.4s infinite;\n}\n.fc-run-live-badge.disconnected {\n  color: var(--err);\n  background: var(--danger-chip);\n  border-color: var(--danger-border);\n}\n.fc-run-live-badge.connecting {\n  color: var(--warn);\n  background: var(--warn-soft);\n  border-color: var(--warn-border);\n}\n\n/* ---------- 7) التبويبات — .tab بخط سفلي، بلا صناديق ---------- */\n.fc-mission-tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 2px;\n  padding: 0 8px;\n  border-bottom: 1px solid var(--line);\n  margin: 0;\n}\n.fc-tab {\n  position: relative;\n  padding: 10px 14px;\n  font-size: 13px;\n  color: var(--mut);\n  background: none;\n  border: 0;\n  border-radius: 0;\n  cursor: pointer;\n  transition: 0.15s;\n}\n.fc-tab:hover { color: var(--text); background: none; }\n.fc-tab.active {\n  color: var(--text);\n  font-weight: 600;\n  background: none;\n}\n.fc-tab.active::after {\n  content: \"\";\n  position: absolute;\n  inset-inline: 10px;\n  bottom: -1px;\n  height: 2px;\n  border-radius: 99px;\n  background: var(--accent);  /* (007 N-3) تبويب واحد ذهبي في كل النظام — الأزرق للحيوية فقط */\n}\n#fc-mission-tab-body { padding: 16px; }\n\n/* ---------- 8) الحقول — .field المرجعي ---------- */\n.fc-form {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 16px;\n}\n.fc-field {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.fc-field label {\n  font-size: 11px;\n  color: var(--dim);\n  margin: 0;\n}\n.fc-field input,\n.fc-field textarea,\n.fc-field select {\n  background: var(--bg);\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  padding: 7px 10px;\n  font-size: 13px;\n  color: var(--text);\n  outline: none;\n  transition: border-color 0.15s;\n  width: 100%;\n}\n.fc-field input:focus,\n.fc-field textarea:focus,\n.fc-field select:focus {\n  border-color: var(--border-strong);\n  box-shadow: 0 0 0 3px var(--accent-agent-soft);\n}\n.fc-field input::placeholder,\n.fc-field textarea::placeholder { color: var(--dim); }\n.fc-field textarea {\n  resize: vertical;\n  min-height: 80px;\n  line-height: 1.8;\n}\n.fc-field select { cursor: pointer; }\n.fc-field select option { background: var(--s1); color: var(--text); }\n\n/* ---------- 9) الأزرار — .btn/.btn.pri المرجعية ---------- */\n#factory-view .btn {\n  border-radius: var(--btn-radius);\n  padding: 8px var(--sp-4);\n  font-size: var(--fs-13);\n  font-weight: 500;\n  cursor: pointer;\n  border: 1px solid var(--line2);\n  background: var(--s2);\n  color: var(--text);\n  transition: 0.15s;\n}\n#factory-view .btn:hover { border-color: var(--border-strong); background: var(--s2); }\n#factory-view .btn:disabled {\n  opacity: 0.55;\n  cursor: default;\n  border-color: var(--line);\n}\n/* (007) الفعل الأساسي ذهبي في كل النظام — الأزرق لدلالة الحيوية فقط */\n#factory-view .btn.primary {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: var(--accent-ink);\n  font-weight: 600;\n}\n#factory-view .btn.primary:hover {\n  background: var(--accent-strong);\n  border-color: var(--accent-strong);\n}\n.fc-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 0 16px 16px;\n  margin: 0;\n}\n.fc-card > .fc-actions { margin-top: 0; }\n\n/* ---------- 10) صفوف القوائم — بلا حدود، تحويم هادئ كالمرجعي ---------- */\n.fc-runs-list,\n.fc-missions-list,\n.fc-tasks-tree,\n.fc-artifacts-list,\n.fc-evidence-list {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: 10px 8px 12px;\n}\n.fc-run-row,\n.fc-mission-row,\n.fc-run-detail {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  padding: 8px 10px;\n  border: 0;\n  border-radius: 10px;\n  background: none;\n  color: var(--mut);\n  cursor: pointer;\n  text-align: start;\n  transition: 0.15s;\n}\n.fc-run-row:hover,\n.fc-mission-row:hover,\n.fc-run-detail:hover {\n  background: var(--bg-hover);\n  color: var(--text);\n}\n.fc-run-info,\n.fc-mission-info {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n  flex: 1;\n}\n.fc-run-id,\n.fc-mission-id {\n  font-family: var(--mono);\n  font-size: 11.5px;\n  font-weight: 500;\n  color: var(--text);\n}\n.fc-run-mission,\n.fc-mission-title {\n  font-size: 11.5px;\n  color: var(--dim);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.fc-run-meta {\n  font-size: 10px;\n  color: var(--dim);\n  font-family: var(--mono);\n  margin: 0;\n}\n\n/* ---------- 11) لوحات عرض التشغيل — بلاطات s2 ---------- */\n.fc-panel {\n  border: 1px solid var(--line);\n  border-radius: var(--r-m);\n  background: var(--s2);\n  padding: 0;\n  min-height: 200px;\n  overflow: hidden;\n}\n.fc-panel h4 {\n  padding: 12px 16px 8px;\n  margin: 0;\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--text);\n  border: 0;\n}\n.fc-panel h4:not(:first-child) {\n  margin-top: 4px;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n}\n.fc-panel > div { padding: 0 16px 16px; }\n.fc-full-width { grid-column: 1 / -1; }\n\n.fc-run-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 4px 2px 0;\n  margin: 0;\n  border: 0;\n}\n.fc-run-header h3 {\n  font-size: 14px;\n  font-weight: 600;\n  margin: 0;\n  color: var(--text);\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---------- 12) صفوف الأحداث والتسلسل — أحادية العرض ---------- */\n.fc-timeline,\n.fc-event-stream {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  max-height: 300px;\n  overflow-y: auto;\n}\n.fc-timeline-item,\n.fc-event-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 10px;\n  border: 1px solid var(--line);\n  border-radius: var(--r-s);\n  background: var(--bg);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  cursor: pointer;\n  transition: 0.15s;\n}\n.fc-timeline-item:hover,\n.fc-event-row:hover {\n  border-color: var(--line2);\n  background: var(--s2);\n}\n.fc-event-time,\n.fc-tl-time {\n  color: var(--dim);\n  flex: none;\n}\n.fc-event-type,\n.fc-tl-type {\n  color: var(--acc);\n  font-weight: 500;\n  flex: none;\n}\n.fc-event-task,\n.fc-tl-detail,\n.fc-event-agent {\n  color: var(--mut);\n  flex: 1;\n  min-width: 0;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* ---------- 13) عقد رسم المهام ---------- */\n.fc-task-graph {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-height: 400px;\n  overflow-y: auto;\n}\n.fc-task-graph-node {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border: 1px solid var(--line);\n  border-radius: var(--r-s);\n  background: var(--bg);\n  font-size: 12px;\n  color: var(--mut);\n  transition: 0.2s;\n}\n.fc-task-graph-node.pending { opacity: 0.5; }\n.fc-task-graph-node.running {\n  border-color: var(--accent-agent-border);\n  background: var(--acc-soft);\n  color: var(--acc-hi);\n}\n.fc-task-graph-node.completed {\n  border-color: var(--ok-border);\n  background: var(--ok-soft);\n  color: var(--ok);\n}\n.fc-task-graph-node.failed {\n  border-color: var(--danger-border);\n  background: var(--danger-soft);\n  color: var(--err);\n}\n.fc-task-graph-node.blocked {\n  border-color: var(--warn-border);\n  background: var(--warn-soft);\n  color: var(--warn);\n  opacity: 0.8;\n}\n\n/* ---------- 14) شجرة مهام المهمة — نقاط حالات كمرجع المشاريع ---------- */\n.fc-task-node {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding: 7px 10px;\n  border: 0;\n  border-radius: 10px;\n  background: none;\n  margin: 0;\n  font-size: 12.5px;\n  color: var(--mut);\n  cursor: default;\n  transition: 0.15s;\n}\n.fc-task-node:hover { background: var(--bg-hover); color: var(--text); }\n.fc-task-status {\n  width: 7px;\n  height: 7px;\n  border-radius: 99px;\n  flex: none;\n  font-size: 0;\n  line-height: 0;\n  overflow: hidden;\n  background: var(--dim);\n}\n.fc-task-status.ok { background: var(--ok); }\n.fc-task-status.warn { background: var(--acc); animation: fc-pulse 1.6s infinite; }\n.fc-task-status.bad { background: var(--err); }\n.fc-task-name { flex: 1; font-weight: 500; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.fc-task-state { font-size: 9.5px; color: var(--dim); font-family: var(--mono); flex: none; }\n.fc-task-agent { font-size: 9.5px; color: var(--acc); font-family: var(--mono); flex: none; }\n\n/* ---------- 15) بطاقات الوكلاء — .pcard المرجعية ---------- */\n.fc-agents-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));\n  gap: 10px;\n  padding: 16px;\n}\n.fc-agent-card {\n  border: 1px solid var(--line);\n  border-radius: var(--r-m);\n  background: var(--s2);\n  padding: 14px;\n}\n.fc-agent-card h4 {\n  font-size: 13px;\n  font-weight: 600;\n  margin: 0 0 10px;\n  color: var(--text);\n}\n.fc-agent-key {\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 400;\n  color: var(--dim);\n}\n.fc-agent-ready {\n  font-size: 11.5px;\n  color: var(--dim);\n  margin: -4px 0 8px;\n}\n.fc-agent-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 11.5px;\n  color: var(--dim);\n}\n\n/* ---------- 16) الكتل البرمجية — لون كود المرجع #9ecbff ---------- */\n.fc-json,\n.fc-json-small {\n  background: var(--bg);\n  border: 1px solid var(--line);\n  border-radius: var(--r-s);\n  padding: 10px 12px;\n  font-size: 11px;\n  line-height: 1.7;\n  color: #9ecbff;\n  overflow: auto;\n  max-height: 240px;\n  font-family: var(--mono);\n  direction: ltr;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n.fc-json-small { max-height: 150px; font-size: 10.5px; }\n\n.fc-current-agent,\n.fc-current-action { min-height: 100px; }\n.fc-agent-info,\n.fc-action-info {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.fc-agent-info div,\n.fc-action-info div {\n  font-size: 12.5px;\n  color: var(--mut);\n}\n.fc-agent-info strong,\n.fc-action-info strong { color: var(--text); font-weight: 600; }\n\n/* ---------- 17) الحالات الفارغة والخطأ — .notice المرجعي ---------- */\n.fc-empty {\n  color: var(--dim);\n  font-size: 12.5px;\n  text-align: center;\n  padding: 28px 16px;\n}\n.fc-loading {\n  color: var(--dim);\n  font-size: 11.5px;\n  font-family: var(--mono);\n  text-align: center;\n  padding: 24px 16px;\n}\n.fc-loading::after {\n  content: \"···\";\n  display: inline-block;\n  margin-inline-start: 6px;\n  color: var(--acc);\n  animation: fc-blink 1s infinite;\n}\n.fc-error {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  color: var(--mut);\n  font-size: 12.5px;\n  text-align: start;\n  padding: 12px 14px;\n  border: 1px solid var(--danger-border);\n  border-inline-start: 3px solid var(--err);\n  background: var(--danger-soft);\n  border-radius: var(--r-m);\n}\n.fc-error::before {\n  content: \"!\";\n  flex: none;\n  width: 20px;\n  height: 20px;\n  display: grid;\n  place-items: center;\n  border-radius: 99px;\n  color: var(--err);\n  border: 1px solid var(--danger-border);\n  font-family: var(--mono);\n  font-size: 11px;\n  font-weight: 600;\n  margin-top: 2px;\n}\n\n/* ---------- 18) صفوف الأدلة والمخرجات ---------- */\n.fc-evidence-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr 1fr;\n  gap: 8px;\n  align-items: center;\n  padding: 8px 12px;\n  border: 1px solid var(--line);\n  border-radius: var(--r-s);\n  background: var(--bg);\n  cursor: pointer;\n  transition: 0.15s;\n}\n.fc-evidence-row:hover,\n.fc-artifact-row:hover {\n  border-color: var(--line2);\n  background: var(--s2);\n}\n.fc-artifact-row {\n  display: grid;\n  grid-template-columns: 80px 1fr 120px 1fr;\n  gap: 8px;\n  align-items: center;\n  padding: 8px 12px;\n  border: 1px solid var(--line);\n  border-radius: var(--r-s);\n  background: var(--bg);\n  cursor: pointer;\n  transition: 0.15s;\n}\n.fc-artifact-type,\n.fc-artifact-name,\n.fc-artifact-sha,\n.fc-artifact-task {\n  font-size: 11px;\n}\n.fc-artifact-type {\n  color: var(--acc);\n  font-weight: 500;\n  font-family: var(--mono);\n}\n.fc-artifact-name { color: var(--text); }\n.fc-artifact-sha {\n  font-family: var(--mono);\n  color: var(--dim);\n}\n.fc-evidence-id {\n  font-family: var(--mono);\n  font-size: 10.5px;\n  color: var(--mut);\n}\n.fc-evidence-type {\n  color: var(--acc);\n  font-weight: 500;\n  font-size: 10.5px;\n  font-family: var(--mono);\n}\n.fc-evidence-hash {\n  font-family: var(--mono);\n  font-size: 10.5px;\n  color: var(--dim);\n}\n.fc-evidence-task,\n.fc-artifact-task {\n  font-size: 10.5px;\n  color: var(--dim);\n}\n\n/* ---------- 19) الحركات المرجعية ---------- */\n@keyframes fc-pulse {\n  0% { box-shadow: 0 0 0 0 rgba(88, 166, 255, 0.35); }\n  70% { box-shadow: 0 0 0 7px transparent; }\n  100% { box-shadow: 0 0 0 0 transparent; }\n}\n@keyframes fc-blink {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.15; }\n}\n\n/* حالات نصية مفردة داخل أجسام التبويبات ولوحة الإجراء الحالي */\n#factory-view .ok { color: var(--ok); }\n#factory-view .bad { color: var(--err); }\n\n/* ---------- 20) الاستجابة ---------- */\n@media (max-width: 1100px) {\n  .fc-grid-3 { grid-template-columns: 1fr; }\n}\n@media (max-width: 900px) {  /* (007) موحد مع مقياس النظام 720/900/1100 */\n  .fc-grid-2 { grid-template-columns: 1fr; }\n  .fc-evidence-row { grid-template-columns: 1fr; gap: 4px; }\n  .fc-artifact-row { grid-template-columns: 1fr; gap: 4px; }\n  .factory-overview,\n  .factory-create-mission,\n  .factory-mission-view,\n  .factory-run-view { padding: 18px 14px 36px; }\n  .fc-mission-tabs { padding: 0 2px; }\n  .fc-tab { padding: 9px 10px; font-size: 12.5px; }\n}\n"
