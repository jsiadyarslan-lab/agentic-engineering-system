        "response": {
          "bodySize": 0,
          "content": {
            "mimeType": "text/css",
            "size": 0,
            "text": "/* ==========================================================================\n   AES-UI-PREMIUM-REDESIGN-007 — نظام التصميم الموحد (إعادة تأسيس)\n   Premium Engineering Workspace — مصدر الحقيقة الوحيد للرموز البصرية.\n\n   يُحمَّل أولاً قبل كل ملفات CSS. يعرّف:\n     1) رموز كاملة: ألوان/خطوط/مقياس طباعي/مسافات/أنصاف/ظلال/طبقات z/حركة.\n     2) أرضية تباين AA مضمونة رقميًا (007: النصوص كلها ≥4.5:1 على أضعف سطح).\n     3) مفردات المكوّنات الأساسية: زر/حبة حالة/حالة فراغ/عزل BiDi تقني.\n   الأسماء القديمة (--muted/--fg/--line/…) تبقى أسماء مستعارة فلا fallbacks متضاربة.\n   الخط: IBM Plex Sans Arabic محلي (صفر موارد خارجية).\n   ========================================================================== */\n\n:root {\n  /* ---------- الطبقات اللونية (فحمي هادئ مزرق) ---------- */\n  --bg: #0D1014;            /* الخلفية العامة */\n  --bg-sidebar: #10141A;    /* الشريط الجانبي */\n  --bg-raised: #141920;     /* أسطح العمل الأساسية */\n  --bg-elevated: #1B222A;   /* الأسطح المرتفعة والقوائم */\n  --bg-input: #161C24;      /* حقول الإدخال */\n  --bg-hover: #1F2731;      /* حالة التحويم الهادئة */\n\n  --bubble-user: #1E2630;\n  --bubble-assistant: transparent;\n\n  /* ---------- الحدود ---------- */\n  --border: #2A333D;\n  --border-soft: #202932;\n  --border-strong: #3A4550;\n\n  /* ---------- النصوص — سُلّم تباين مقيس (007) ----------\n     text 17.1:1 · mid 8.7:1 · dim 7.0:1 · faint 5.8:1 على --bg\n     وكلها ≥4.9:1 على أضعف سطح elevated — لا فشل AA في أي نص محتوى. */\n  --text: #F0F3F6;\n  --text-mid: #A6B0BC;\n  --text-dim: #939EA9;\n  --text-faint: #84909C;\n  --text-disabled: #5C6670;  /* للعناصر المعطلة فقط (معفاة من AA) */\n\n  /* ---------- التمييز: ذهبي هادئ واحد ---------- */\n  --accent: #D4AC55;\n  --accent-strong: #E2BE6A;\n  --accent-soft: rgba(212, 172, 85, 0.10);\n  --accent-softer: rgba(212, 172, 85, 0.05);\n  --accent-border: rgba(212, 172, 85, 0.38);\n  --accent-ink: #171307;    /* نص فوق خلفية ذهبية صلبة */\n\n  /* ---------- تمييز الوكيل/النظام (007) ----------\n     أزرق مرجع المصنع 003 يصبح دلالة «حيوية وكيل» داخل النظام الواحد،\n     لا لوحة موازية: شارات LIVE ونبض النشاط فقط. */\n  --accent-agent: #58A6FF;\n  --accent-agent-soft: rgba(88, 166, 255, 0.12);\n  --accent-agent-border: rgba(88, 166, 255, 0.38);\n\n  /* ---------- الحالات الدلالية (مفهومة بالنص والرمز لا باللون وحده) ---------- */\n  --ok: #5CB87A;\n  --ok-soft: rgba(92, 184, 122, 0.10);\n  --ok-border: rgba(92, 184, 122, 0.35);\n  --ok-chip: rgba(92, 184, 122, 0.14);\n\n  --danger: #E06C5F;\n  --danger-soft: rgba(224, 108, 95, 0.09);\n  --danger-border: rgba(224, 108, 95, 0.38);\n  --danger-chip: rgba(224, 108, 95, 0.14);\n\n  --warn: #D9A03F;\n  --warn-soft: rgba(217, 160, 63, 0.10);\n  --warn-border: rgba(217, 160, 63, 0.36);\n  --warn-chip: rgba(217, 160, 63, 0.14);\n\n  --info: #5B9BD5;\n  --info-soft: rgba(91, 155, 213, 0.10);\n  --info-border: rgba(91, 155, 213, 0.36);\n  --info-chip: rgba(91, 155, 213, 0.14);\n\n  /* ---------- أدوار المصنع — ألوان هوية داخل النظام الواحد (007) ---------- */\n  --role-thinker: #D98BA8;\n  --role-implementer: #B8A3F0;\n  --role-arbiter: var(--warn);\n\n  /* ---------- الخطوط (007: كانت خمس مداخل mono متنافرة) ---------- */\n  --font-sans: \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", \"Segoe UI\",\n               Tahoma, system-ui, sans-serif;\n  --font-mono: \"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo,\n               Consolas, monospace;\n\n  /* ---------- المقياس الطباعي (007: هرمية منضبطة 11→28) ----------\n     11: وسم علوي صغير فقط · 12: وصف/طوابع زمنية · 13: تنقل وثانوي\n     15: جسم · 17: عنوان بطاقة · 19: رأس قسم · 22/28: الترحيب. */\n  --fs-11: 11px;\n  --fs-12: 12px;\n  --fs-13: 13px;\n  --fs-14: 14px;\n  --fs-15: 15px;\n  --fs-17: 17px;\n  --fs-19: 19px;\n  --fs-22: 22px;\n  --fs-28: 28px;\n\n  /* ---------- المقياس (شبكة 4px) ---------- */\n  --sp-1: 4px;\n  --sp-2: 8px;\n  --sp-3: 12px;\n  --sp-4: 16px;\n  --sp-5: 20px;\n  --sp-6: 24px;\n  --sp-8: 32px;\n  --sp-10: 40px;\n\n  /* ---------- الأنصاف والزوايا ---------- */\n  --radius-s: 6px;\n  --radius-m: 10px;\n  --radius-l: 14px;\n  --radius-pill: 999px;\n\n  /* ---------- الظلال (خفيفة — مساحة عمل لا معرض) ---------- */\n  --shadow-1: 0 1px 3px rgba(0, 0, 0, 0.32);\n  --shadow-2: 0 8px 24px rgba(0, 0, 0, 0.38);\n  --shadow-modal: 0 24px 64px rgba(0, 0, 0, 0.55), 0 4px 16px rgba(0, 0, 0, 0.35);\n\n  /* ---------- الأبعاد ---------- */\n  --chat-width: 920px;      /* (007) عمود المحتوى — متطابق مع عقد 920px في app-shell.css */\n  --sidebar-width: 264px;\n  --drawer-width: 440px;\n  --header-h: 56px;\n\n  /* ---------- الحركة ---------- */\n  --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);\n  --dur-fast: 0.14s;\n  --dur: 0.22s;\n  --dur-slow: 0.32s;\n\n  /* ---------- الطبقات z — سلّم واحد (007: كان مخططين متداخلين) ----------\n     content 30 · raised 40 (قوائم منبثقة داخل سطح) · sidebar 50 ·\n     sticky 55 (أزرار عائمة) · drawer 61 + لوحه 62 · modal 70 ·\n     popover 71 (فوق المودال كمنتقي نماذج) · boundary 300. */\n  --z-content: 30;\n  --z-raised: 40;\n  --z-sidebar: 50;\n  --z-sticky: 55;\n  --z-drawer: 61;\n  --z-drawer-panel: 62;\n  --z-modal: 70;\n  --z-popover: 71;\n  --z-boundary: 300;\n\n  /* ==========================================================================\n     الأسماء القديمة — مستعارة إلى النظام (تُصان حتى تُنقى مصادرها).\n     ========================================================================== */\n  --panel: var(--bg-raised);\n  --panel-2: var(--bg-elevated);\n  --ink: var(--text);\n  --ink-2: var(--text-mid);\n  --line: var(--border-soft);\n  --muted: var(--text-dim);\n  --fg: var(--text);\n  --card: var(--bg-raised);\n  --card-2: var(--bg-elevated);\n\n  --ok-strong: var(--ok);\n  --ok-bg: var(--ok-chip);\n  --danger-strong: var(--danger);\n  --danger-bg: var(--danger-chip);\n  --warn-strong: var(--warn);\n  --warn-bg: var(--warn-chip);\n  --info-strong: var(--info);\n  --info-bg: var(--info-chip);\n}\n\n/* ---------- احترام تقليل الحركة ---------- */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ---------- التركيز المرئي الموحد (لوحة المفاتيح) ---------- */\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n  border-radius: var(--radius-s);\n}\n\n::selection {\n  background: rgba(212, 172, 85, 0.28);\n  color: var(--text);\n}\n\n/* ---------- شريط التمرير الموحد ---------- */\n::-webkit-scrollbar { width: 10px; height: 10px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb {\n  background: #2C3640;\n  border-radius: var(--radius-pill);\n  border: 2px solid var(--bg);\n}\n::-webkit-scrollbar-thumb:hover { background: #3A4550; }\n\n/* ---------- الأيقونات الوظيفية الموحدة (SVG داخل .icon) ---------- */\n.icon {\n  width: 18px;\n  height: 18px;\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: currentColor;\n}\n.icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n.icon.sm { width: 15px; height: 15px; }\n.icon.lg { width: 22px; height: 22px; }\n\n/* شارة حالة صغيرة — نقطة + نص، مفهومة بلا لون */\n.status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--text-faint);\n  flex: none;\n  display: inline-block;\n}\n.status-dot.on { background: var(--ok); }\n.status-dot.off { background: var(--warn); }\n.status-dot.err { background: var(--danger); }\n.status-dot.live { background: var(--accent-agent); }\n\n/* ==========================================================================\n   مفردات المكوّنات الأساسية (007) — القواعد الهندسية الموحدة.\n   كل عائلات الأزرار/الحبوب/الفراغ في بقية الملفات تُبنى من نفس هذه\n   القيم فتتوحد بالبناء دون كسر أسماء الفئات التي تعتمدها الاختبارات.\n   ========================================================================== */\n\n/* ---------- الزر الموحد: قيم مرجعية تستهلكها عائلات الأزرار ----------\n   (الارتفاع 34px · الصغير 28px · نصف القطر 8px — نفس القيم في كل سطح) */\n:root {\n  --btn-h: 34px;\n  --btn-h-sm: 28px;\n  --btn-radius: 8px;\n  --btn-font: var(--fs-13);\n}\n\n/* ---------- حبة الحالة الموحدة: 11px/600 على 20px بلون دلالي ---------- */\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--sp-1);\n  height: 20px;\n  padding: 0 var(--sp-2);\n  border-radius: var(--radius-pill);\n  font-size: var(--fs-11);\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  background: var(--bg-elevated);\n  color: var(--text-mid);\n  border: 1px solid var(--border-soft);\n  white-space: nowrap;\n}\n.chip.ok     { background: var(--ok-chip);     color: var(--ok);     border-color: var(--ok-border); }\n.chip.danger { background: var(--danger-chip); color: var(--danger); border-color: var(--danger-border); }\n.chip.warn   { background: var(--warn-chip);   color: var(--warn);   border-color: var(--warn-border); }\n.chip.info   { background: var(--info-chip);   color: var(--info);   border-color: var(--info-border); }\n.chip.agent  { background: var(--accent-agent-soft); color: var(--accent-agent); border-color: var(--accent-agent-border); }\n\n/* ---------- حالة الفراغ الموحدة: علامة + عنوان + إرشاد + فعل اختياري ---------- */\n.empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--sp-2);\n  padding: var(--sp-8) var(--sp-6);\n  text-align: center;\n  color: var(--text-dim);\n}\n.empty-state .empty-mark {\n  width: 40px;\n  height: 40px;\n  border-radius: var(--radius-m);\n  border: 1px solid var(--border-soft);\n  background: var(--bg-raised);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text-faint);\n  margin-bottom: var(--sp-1);\n}\n.empty-state .empty-title {\n  font-size: var(--fs-15);\n  font-weight: 600;\n  color: var(--text-mid);\n}\n.empty-state .empty-hint {\n  font-size: var(--fs-13);\n  color: var(--text-dim);\n  max-width: 44ch;\n  line-height: 1.6;\n}\n\n/* ---------- عزل السلاسل التقنية داخل النص العربي (007: BiDi) ----------\n   المسارات ورموز الحالة وأسماء المزودين تُعرض LTR معزولة بخط mono،\n   فلا تقفز علامات الترقيم ولا تنقلب الأقواس. */\n.tech, .md-code, code, pre {\n  font-family: var(--font-mono);\n  direction: ltr;\n  unicode-bidi: isolate;\n  text-align: left;\n}\n\n.kbd {\n  display: inline-block;\n  padding: 1px var(--sp-1);\n  border-radius: var(--radius-s);\n  border: 1px solid var(--border);\n  border-bottom-width: 2px;\n  background: var(--bg-elevated);\n  font-family: var(--font-mono);\n  font-size: var(--fs-11);\n  color: var(--text-mid);\n  direction: ltr;\n  unicode-bidi: isolate;\n}\n"
          },
