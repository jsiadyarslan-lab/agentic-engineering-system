            "mimeType": "text/css",
            "size": 0,
            "text": "/* (013.4 + 007) مركز التحكم + سير العمل + الويب في المحادثة —\n * نقي الرموز بالكامل: كانت هنا بقايا لوحة فاتحة (rgba(15,23,42,…)\n * و fallbacks #fff) تكاد تختفي على الداكن، وطبقة ترقيع تعالجها في\n * project-live.css — الجذر أُصلح هنا فسقطت الطبقة.\n * التنقل الجانبي وweb-toggle ملك styles.css (كانت مزدوجة متضاربة).\n * المحادثة أساسًا، مؤشرات حالة موحدة، إفصاح تدريجي، فعل أساسي واحد. */\n\n/* ---------- نقطة التشغيل الحي بجانب المشروع (§33) ---------- */\n.proj-run-dot { font-size: var(--fs-11); margin-inline-end: var(--sp-1); }\n.proj-run-dot.live { color: var(--accent-agent); }  /* (007 N-4) حي=أزرق وكيل */\n.proj-run-dot.paused { color: var(--warn); }\n.proj-run-dot.waiting { color: var(--warn); }\n.proj-run-dot.warn { color: var(--danger); }\n.proj-run-dot.ok { color: var(--ok); }\n\n/* ---------- أسطح مركز التحكم (runs/archive) ---------- */\n.cc-view {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg);\n  z-index: var(--z-content);\n}\n.cc-view[hidden] { display: none; }\n.cc-head {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px var(--sp-4);\n  background: var(--bg-sidebar);\n  border-bottom: 1px solid var(--border-soft);\n}\n.cc-title { font-weight: 600; font-size: var(--fs-15); }\n.cc-sub { color: var(--text-dim); font-size: var(--fs-12); }\n.cc-scroll { flex: 1; overflow-y: auto; }\n.cc-body {\n  max-width: 720px;\n  margin: 0 auto;\n  padding: var(--sp-4) var(--sp-4) 40px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n/* (007) حالة فراغ/تحميل موحدة — نفس قواعد .empty-state في theme.css */\n.cc-empty, .cc-loading {\n  padding: 28px 18px;\n  text-align: center;\n  color: var(--text-dim);\n  background: var(--bg-raised);\n  border-radius: var(--radius-l);\n  border: 1px dashed var(--border);\n  font-size: var(--fs-13);\n  line-height: 1.9;\n}\n.cc-run-card {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-3);\n  padding: var(--sp-4) var(--sp-4);\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-l);\n  cursor: pointer;\n  text-align: start;\n  font: inherit;\n  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);\n}\n.cc-run-card:hover { border-color: var(--border-strong); background: var(--bg-elevated); }\n.cc-run-dot { font-size: var(--fs-15); }\n.cc-run-dot.live { color: var(--accent-agent); animation: cc-pulse 2s infinite; }  /* (007 N-4) */\n.cc-run-dot.paused { color: var(--warn); }\n.cc-run-dot.waiting { color: var(--warn); }\n.cc-run-dot.warn { color: var(--danger); }\n.cc-run-dot.ok { color: var(--ok); }\n@keyframes cc-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: .45; }\n}\n.cc-run-text { flex: 1; min-width: 0; }\n.cc-run-title {\n  font-weight: 600;\n  font-size: var(--fs-14);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.cc-run-sub {\n  color: var(--text-dim);\n  font-size: var(--fs-12);\n  margin-top: 3px;\n}\n.cc-run-bar {\n  height: 4px;\n  border-radius: 4px;\n  background: var(--bg-elevated);\n  overflow: hidden;\n  margin-top: 7px;\n}\n.cc-run-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--info), var(--ok));\n  transition: width .5s ease;\n}\n.cc-run-open { color: var(--text-dim); font-size: var(--fs-12); }\n.cc-archive-card {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-3);\n  padding: var(--sp-4) var(--sp-4);\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-l);\n}\n.cc-restore-btn {\n  padding: 7px 14px;\n  border-radius: var(--btn-radius);\n  border: 1px solid var(--info-border);\n  background: var(--info-soft);\n  color: var(--info);\n  font: inherit;\n  font-size: var(--fs-13);\n  cursor: pointer;\n}\n.cc-restore-btn:hover { background: var(--info-chip); }\n\n/* ---------- تبويبات المشروع + رأسه (§9+§10) — قواعد التبويب الموحدة ---------- */\n.pl-tabs {\n  display: flex;\n  gap: 2px;\n  padding: 0 var(--sp-4);\n  background: var(--bg-sidebar);\n  border-bottom: 1px solid var(--border-soft);\n  overflow-x: auto;\n}\n.pl-tab {\n  padding: 9px 14px;\n  border: none;\n  background: transparent;\n  color: var(--text-dim);\n  font: inherit;\n  font-size: var(--fs-13);\n  font-weight: 600;\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  white-space: nowrap;\n}\n.pl-tab:hover { color: var(--text); }\n.pl-tab.active {\n  color: var(--text);\n  border-bottom-color: var(--accent);\n}\n.pl-head-meta {\n  color: var(--text-dim);\n  font-size: var(--fs-12);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  flex: 1;\n  min-width: 0;\n}\n.pl-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-1);\n  flex-shrink: 0;\n}\n/* (007) أزرار إجراءات المشروع من النظام الموحد — نفس هندسة .btn */\n.pl-act-btn {\n  padding: 5px 11px;\n  border-radius: var(--btn-radius);\n  border: 1px solid var(--border);\n  background: var(--bg-raised);\n  color: var(--text);\n  font: inherit;\n  font-size: var(--fs-12);\n  cursor: pointer;\n  white-space: nowrap;\n  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);\n}\n.pl-act-btn:hover { border-color: var(--border-strong); background: var(--bg-hover); }\n.pl-act-btn.primary {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: var(--accent-ink);\n  font-weight: 600;\n}\n.pl-act-btn.primary:hover { background: var(--accent-strong); }\n.pl-act-btn.danger { color: var(--danger); border-color: var(--danger-border); }\n.pl-act-btn.more { padding: 5px 9px; }\n.pl-act-btn:disabled { opacity: 0.45; cursor: not-allowed; }\n.pl-more-wrap { position: relative; }\n.pl-more-menu {\n  position: absolute;\n  top: calc(100% + 6px);\n  inset-inline-end: 0;\n  min-width: 210px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-m);\n  box-shadow: var(--shadow-2);\n  padding: 5px;\n  z-index: var(--z-raised);\n}\n.pl-more-menu[hidden] { display: none; }\n.pl-more-menu button {\n  display: block;\n  width: 100%;\n  padding: var(--sp-2) var(--sp-3);\n  border: none;\n  background: transparent;\n  text-align: start;\n  font: inherit;\n  font-size: var(--fs-13);\n  border-radius: var(--radius-s);\n  cursor: pointer;\n  color: var(--text-mid);\n}\n.pl-more-menu button:hover { background: var(--bg-hover); color: var(--text); }\n.pl-tab-body { max-width: var(--chat-width); margin: 0 auto; padding: var(--sp-4) var(--sp-4) 50px; }\n.pl-scene[hidden] { display: none; }\n\n/* ---------- بطاقة التخطيط الحي (§3+§36) ---------- */\n.pl-plan-live .pl-exec-dot {\n  color: var(--ok);\n  animation: cc-pulse 1.6s infinite;\n}\n.pl-plan-live .pl-note {\n  margin-top: var(--sp-2);\n  color: var(--text-dim);\n  font-size: var(--fs-12);\n  line-height: 1.6;\n}\n\n/* ---------- عرض سير العمل (§19-§23) ---------- */\n.wf-card {\n  background: var(--bg-raised);\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-l);\n  padding: 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.wf-section-title { font-size: var(--fs-13); font-weight: 700; margin: 0; }\n.wf-pipeline {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 2px;\n}\n.wf-stage {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--sp-1);\n  padding: var(--sp-2) 10px;\n  border-radius: var(--radius-m);\n  cursor: pointer;\n  border: 1px solid transparent;\n  transition: background var(--dur-fast) var(--ease);\n}\n.wf-stage:hover { background: var(--bg-hover); }\n.wf-stage-dot { font-size: var(--fs-15); line-height: 1; }\n.wf-stage-label { font-size: var(--fs-12); }\n.wf-stage.current .wf-stage-dot { color: var(--accent); }\n.wf-stage.current .wf-stage-label {\n  color: var(--accent);\n  font-weight: 700;\n}\n.wf-stage.current {\n  background: var(--accent-soft);\n  border-color: var(--accent-border);\n}\n.wf-stage.done .wf-stage-dot { color: var(--ok); }\n.wf-stage.done .wf-stage-label { color: var(--text-dim); }\n.wf-stage.future .wf-stage-dot { color: var(--text-faint); }\n.wf-stage.future .wf-stage-label { color: var(--text-dim); }\n.wf-stage-arrow {\n  color: var(--text-faint);\n  font-size: var(--fs-11);\n  margin-inline: 1px;\n}\n.wf-blocking {\n  border: 1px solid var(--warn-border);\n  background: var(--warn-soft);\n  border-radius: var(--radius-m);\n  padding: var(--sp-3) var(--sp-4);\n}\n.wf-blocking-title { font-weight: 700; font-size: var(--fs-13); color: var(--warn); }\n.wf-blocking-reason {\n  margin-top: 5px;\n  font-size: var(--fs-13);\n  line-height: 1.7;\n  color: var(--text);\n}\n.wf-blocking-hint { margin-top: var(--sp-1); font-size: var(--fs-12); color: var(--warn); }\n.wf-planning-live {\n  border: 1px solid var(--info-border);\n  background: var(--info-soft);\n  border-radius: var(--radius-m);\n  padding: var(--sp-3) var(--sp-4);\n}\n.wf-planning-title { font-weight: 700; font-size: var(--fs-13); }\n.wf-planning-rows { margin-top: var(--sp-2); display: grid; gap: var(--sp-1); }\n.wf-planning-row { display: flex; gap: var(--sp-2); font-size: var(--fs-12); }\n.wf-pl-k { color: var(--text-dim); min-width: 74px; }\n.wf-pl-v { font-weight: 600; direction: ltr; unicode-bidi: isolate; text-align: end; }\n.wf-roles { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }\n.wf-role {\n  padding: 4px 10px;\n  border-radius: var(--radius-pill);\n  font-size: var(--fs-12);\n  background: var(--bg-elevated);\n  color: var(--text-mid);\n}\n.wf-role.current {\n  background: var(--ok-chip);\n  color: var(--ok);\n  font-weight: 700;\n}\n.wf-role.muted { color: var(--text-dim); }\n.wf-roles-trail { display: flex; gap: var(--sp-1); flex-wrap: wrap; }\n.wf-progress { display: flex; align-items: center; gap: 10px; }\n.wf-progress-bar {\n  flex: 1;\n  height: 6px;\n  border-radius: 6px;\n  background: var(--bg-elevated);\n  overflow: hidden;\n}\n.wf-progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--info), var(--ok));\n  transition: width .5s ease;\n}\n.wf-progress-text { font-size: var(--fs-12); color: var(--text-dim); }\n.wf-details {\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-m);\n  padding: var(--sp-3) var(--sp-4);\n}\n.wf-details[hidden] { display: none; }\n.wf-details-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.wf-details-title { font-weight: 700; font-size: var(--fs-13); }\n.wf-details-close {\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  font-size: var(--fs-13);\n  color: var(--text-dim);\n}\n.wf-details-rows { margin-top: var(--sp-2); display: grid; gap: 5px; }\n.wf-details-row { display: flex; gap: var(--sp-2); font-size: var(--fs-13); }\n.wf-objective { font-size: var(--fs-13); line-height: 1.8; }\n.wf-phases { display: grid; gap: var(--sp-1); }\n.wf-phase-line { font-size: var(--fs-13); color: var(--text); }\n.wf-empty {\n  padding: 22px;\n  text-align: center;\n  color: var(--text-dim);\n  font-size: var(--fs-13);\n}\n.wf-evidence-row, .wf-artifact-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px var(--sp-1);\n  border-bottom: 1px solid var(--border-soft);\n}\n.wf-evidence-badge { font-size: var(--fs-14); color: var(--ok); }\n.wf-evidence-text { flex: 1; min-width: 0; }\n.wf-evidence-line { font-size: var(--fs-13); }\n.wf-evidence-sub {\n  font-size: var(--fs-11);\n  color: var(--text-dim);\n  margin-top: 2px;\n}\n.wf-evidence-time { font-size: var(--fs-11); color: var(--text-dim); }\n.wf-artifact-icon { font-size: var(--fs-15); }\n.wf-artifact-sha {\n  border: 1px solid var(--border);\n  background: transparent;\n  border-radius: var(--radius-s);\n  padding: 3px var(--sp-2);\n  font-size: var(--fs-11);\n  cursor: pointer;\n  color: var(--text-dim);\n  font-family: var(--font-mono);\n  direction: ltr;\n  unicode-bidi: isolate;\n}\n.wf-history-list { display: flex; flex-direction: column; }\n.wf-history-line {\n  display: flex;\n  align-items: baseline;\n  gap: var(--sp-2);\n  padding: var(--sp-1) var(--sp-1);\n  border-bottom: 1px solid var(--border-soft);\n  font-size: var(--fs-13);\n}\n.wf-history-time {\n  font-size: var(--fs-11);\n  color: var(--text-dim);\n  min-width: 44px;\n  direction: ltr;\n  unicode-bidi: isolate;\n}\n.wf-history-dot { font-size: var(--fs-11); }\n.wf-history-text { flex: 1; min-width: 0; }\n.wf-history-json {\n  border: none;\n  background: transparent;\n  color: var(--text-dim);\n  cursor: pointer;\n  font-size: var(--fs-11);\n}\n.wf-history-more {\n  margin-top: 10px;\n  align-self: center;\n  padding: 7px 18px;\n  border-radius: var(--btn-radius);\n  border: 1px solid var(--border);\n  background: var(--bg-raised);\n  color: var(--text-mid);\n  font: inherit;\n  font-size: var(--fs-12);\n  cursor: pointer;\n}\n.wf-history-more:hover { border-color: var(--border-strong); color: var(--text); }\n.wf-history-more[hidden] { display: none; }\n\n/* ---------- الويب في المحادثة (§26) ---------- */\n.web-used-bar {\n  margin-top: var(--sp-2);\n  border-top: 1px dashed var(--border-soft);\n  padding-top: 7px;\n}\n.web-used-head {\n  border: none;\n  background: transparent;\n  color: var(--text-dim);\n  font: inherit;\n  font-size: var(--fs-12);\n  cursor: pointer;\n  padding: 2px 0;\n}\n.web-used-head.open { color: var(--accent); }\n.web-used-head::after { content: \" ▾\"; font-size: 9px; }\n.web-used-head.open::after { content: \" ▴\"; }\n.web-used-sources { display: flex; flex-direction: column; gap: 3px; }\n.web-used-sources[hidden] { display: none; }\n.web-source {\n  color: var(--accent);\n  text-decoration: none;\n  font-size: var(--fs-12);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  direction: ltr;\n  unicode-bidi: isolate;\n  text-align: left;\n}\n.web-source:hover { text-decoration: underline; }\n\n/* ---------- شاشات صغيرة ---------- */\n@media (max-width: 720px) {\n  .pl-head-meta { display: none; }\n  .pl-act-btn { padding: 5px var(--sp-2); font-size: var(--fs-11); }\n  .wf-stage { padding: var(--sp-1) 7px; }\n}\n"
          },
